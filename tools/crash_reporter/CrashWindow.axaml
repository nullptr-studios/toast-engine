<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="crash_reporter.CrashWindow"
        Title="Toast Engine crashed"
        Width="1000"
        Height="640"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg3}"
        Padding="8">

	<DockPanel VerticalSpacing="8">
		<StackPanel DockPanel.Dock="Top"
		            Spacing="6">
			<TextBlock x:Name="TitleText"
			           FontSize="20"
			           FontWeight="Bold"
			           Text="The process crashed" />
			<SelectableTextBlock x:Name="ReasonText"
			                     TextWrapping="Wrap"
			                     Foreground="{StaticResource TextMuted}" />
			<SelectableTextBlock x:Name="MessageText"
			                     TextWrapping="Wrap"
			                     IsVisible="False"
			                     FontFamily="Fira Code, Consolas, monospace"
			                     FontSize="12" />
		</StackPanel>

		<Grid DockPanel.Dock="Bottom"
		      ColumnDefinitions="*,Auto">
			<TextBlock x:Name="StatusText"
			           VerticalAlignment="Center"
			           TextTrimming="CharacterEllipsis"
			           Opacity="0.7"/>
			<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
				<Button x:Name="CopyButton"
				        Content="Copy"
				        Click="OnCopy"
				        IsEnabled="False"
				        CornerRadius="6"/>
				<Button x:Name="OpenFolderButton"
				        Content="Open folder"
				        Click="OnOpenFolder"
				        IsVisible="False"
				        CornerRadius="6"/>
				<Button x:Name="DumpButton"
				        Content="Save full dump"
				        Click="OnSaveDump"
				        IsEnabled="False"
				        Classes="accent"
				        CornerRadius="6"/>
				<Button Content="Close"
				        Click="OnClose"
				        CornerRadius="6"/>
			</StackPanel>
		</Grid>

		<TextBox x:Name="StackText"
		         IsReadOnly="True"
		         AcceptsReturn="True"
		         TextWrapping="NoWrap"
		         FontFamily="Fira Code, Consolas, monospace"
		         FontSize="12"
		         ScrollViewer.HorizontalScrollBarVisibility="Auto"
		         ScrollViewer.VerticalScrollBarVisibility="Auto"
		         Text="Resolving symbols..."
		         Background="{StaticResource Bg1}"
		         BorderThickness="0"
		         CornerRadius="8"/>
	</DockPanel>

</Window>
