<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="crash_reporter.CrashWindow"
        Title="Toast Engine crashed"
        Width="1000" Height="640"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen">

	<DockPanel Margin="16">
		<StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
			<TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Text="The process crashed" />
			<SelectableTextBlock x:Name="ReasonText" TextWrapping="Wrap" Foreground="{DynamicResource SystemAccentColor}" />
			<SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" IsVisible="False"
			                     FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />
		</StackPanel>

		<Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
			<TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.7" />
			<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
				<Button x:Name="CopyButton" Content="Copy" Click="OnCopy" IsEnabled="False" />
				<Button x:Name="OpenFolderButton" Content="Open folder" Click="OnOpenFolder" IsVisible="False" />
				<Button x:Name="DumpButton" Content="Save full dump" Click="OnSaveDump" IsEnabled="False" Classes="accent" />
				<Button Content="Close" Click="OnClose" />
			</StackPanel>
		</Grid>

		<TextBox x:Name="StackText"
		         IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
		         FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
		         ScrollViewer.HorizontalScrollBarVisibility="Auto"
		         ScrollViewer.VerticalScrollBarVisibility="Auto"
		         Text="Resolving symbols..." />
	</DockPanel>

</Window>
