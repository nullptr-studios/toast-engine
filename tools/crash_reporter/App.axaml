<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="crash_reporter.App"
             RequestedThemeVariant="Dark">

	<Application.Resources>
		<ResourceDictionary>
			<Color x:Key="SystemAccentColor">#ff1659</Color>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://crash_reporter/Resources/EditorColors.axaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>

	<Application.Styles>
		<FluentTheme />
	</Application.Styles>

</Application>
