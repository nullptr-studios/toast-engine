{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "core://schemas/curve.schema.json",
  "title": "Toast Curve (.tcurve)",
  "type": "object",
  "required": ["spline_type", "dimension"],
  "additionalProperties": false,
  "properties": {
    "spline_type": {
      "enum": ["linear", "catmull_rom", "bspline", "bezier"],
      "x-toast-type": "enum",
      "description": "linear: piecewise straight lines, catmull_rom: smooth interpolation through all points, bspline: smooth cubic approximation, bezier: compound cubic with explicit tangent handles"
    },
    "dimension": {
      "enum": ["1d", "2d", "3d"],
      "x-toast-type": "enum"
    },
    "t_scale": {
      "type": "number",
      "x-toast-type": "float",
      "default": 1.0,
      "exclusiveMinimum": 0
    },
    "points": {
      "type": "array",
      "x-toast-type": "point[]",
      "minItems": 2,
      "items": { "$ref": "#/definitions/point" }
    },
    "channels": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": { "$ref": "#/definitions/channel" }
    }
  },
  "definitions": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "x-toast-type": "float" },
        "y": { "type": "number", "x-toast-type": "float" },
        "z": { "type": "number", "x-toast-type": "float", "description": "Only in old \"3d\" path curves" }
      }
    },
    "channel": {
      "type": "object",
      "required": ["points"],
      "additionalProperties": false,
      "properties": {
        "name": { "enum": ["x", "y", "z"] },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/definitions/point" }
        }
      }
    }
  }
}
