{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "core://schemas/audio.schema.json",
  "title": "Audio Assets Schema",
  "description": "FMOD object (event, bus, vca, port, snapshot)",
  "type": "object",
  "required": ["type", "name", "path", "guid"],
  "additionalProperties": false,
  "properties": {
    "type": { "type": "string", "x-toast-type": "string", "description": "FMOD object kind" },
    "name": { "type": "string", "x-toast-type": "string", "description": "Display name" },
    "path": { "type": "string", "x-toast-type": "string", "description": "FMOD path (event:/Music/Theme)" },
    "guid": { "type": "string", "x-toast-type": "string", "description": "FMOD GUID ({xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx})" }
  }
}
