{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "core://schemas/project_settings.schema.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "x-toast-type": "string",
      "description": "Human-readable project name",
      "default": "Untitled"
    },
    "version": {
      "type": "array",
      "x-toast-type": "int[]",
      "description": "Project version as [major, minor, patch]",
      "default": [
        1,
        0,
        0
      ]
    }
  }
}
