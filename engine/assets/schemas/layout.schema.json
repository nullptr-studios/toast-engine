{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "core://schemas/layout.schema.json",
  "title": "Toast Input Layout (.tlayout)",
  "description": "Maps input actions to layers, controlling which actions are active in each gameplay context",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name":   { "type": "string", "x-toast-type": "string", "default": "Unnamed Layout" },
    "layers": { "type": "array",  "x-toast-type": "string[]", "default": [] },
    "action": { "type": "array",  "x-toast-type": "entry[]" }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id":       { "type": "string", "x-toast-type": "asset",    "x-toast-asset-type": "input_action" },
        "included": { "type": "array",  "x-toast-type": "string[]", "description": "Layers this action will run" },
        "excluded": { "type": "array",  "x-toast-type": "string[]", "description": "Layers this action will not run" }
      }
    }
  }
}
