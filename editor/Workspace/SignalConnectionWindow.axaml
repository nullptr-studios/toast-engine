<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:editor.Workspace"
        xmlns:conv="using:editor.Components.Converters"
        xmlns:elements="using:editor.Components.Elements"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="860"
        d:DesignHeight="760"
        x:Class="editor.Workspace.SignalConnectionWindow"
        x:DataType="vm:SignalConnectionDialogViewModel"
        Title="Add signal connection"
        Width="860"
        Height="760"
        MinWidth="680"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Padding="8"
        Background="{StaticResource Bg2}">
	<Design.DataContext>
		<vm:SignalConnectionDialogViewModel />
	</Design.DataContext>

	<Window.Resources>
		<conv:ResourceBrushConverter x:Key="BrushFromKey" />
	</Window.Resources>

	<Window.Styles>
		<Style Selector="ItemsControl.params > ContentPresenter"
		       x:DataType="vm:SignalParameterViewModel">
			<Setter Property="elements:SpanPanel.Span"
			        Value="{Binding ColumnSpan}" />
		</Style>
		<Style Selector="Border.param-slot.vec">
			<Setter Property="BorderThickness"
			        Value="0" />
			<Setter Property="Background"
			        Value="Transparent" />
		</Style>
		<Style Selector="Border.arg-chip">
			<Setter Property="Background"
			        Value="{StaticResource Bg2}" />
			<Setter Property="BorderBrush"
			        Value="{StaticResource Bg4}" />
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background"
					                 Duration="0:0:0.12" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Border.arg-chip:pointerover">
			<Setter Property="Background"
			        Value="{StaticResource Bg4}" />
		</Style>
		<Style Selector="TreeView.connection-workspace TreeViewItem">
			<Setter Property="IsExpanded"
			        Value="True" />
		</Style>
		<Style Selector="TreeView.connection-workspace TreeViewItem /template/ Border#PART_LayoutRoot">
			<Setter Property="Background"
			        Value="Transparent" />
			<Setter Property="CornerRadius"
			        Value="6" />
		</Style>
		<Style Selector="TreeView.connection-workspace TreeViewItem:selected /template/ Border#PART_LayoutRoot">
			<Setter Property="Background"
			        Value="{StaticResource Bg3}" />
		</Style>
		<Style Selector="TreeView.connection-workspace TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
			<Setter Property="Background"
			        Value="{StaticResource Bg4}" />
		</Style>
		<Style Selector="TreeView.connection-workspace TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
			<Setter Property="Background"
			        Value="{StaticResource Bg4}" />
		</Style>
		<Style Selector="ListBox.connection-functions ListBoxItem">
			<Setter Property="Padding"
			        Value="4" />
			<Setter Property="HorizontalContentAlignment"
			        Value="Stretch" />
			<Setter Property="Background"
			        Value="Transparent" />
			<Setter Property="CornerRadius"
			        Value="6" />
		</Style>
		<Style Selector="ListBox.connection-functions ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="Transparent" />
			<Setter Property="CornerRadius"
			        Value="6" />
		</Style>
		<Style Selector="ListBox.connection-functions ListBoxItem:selected">
			<Setter Property="Background"
			        Value="{StaticResource Bg3}" />
		</Style>
		<Style Selector="ListBox.connection-functions ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Bg3}" />
		</Style>
		<Style Selector="ListBox.connection-functions ListBoxItem:pointerover">
			<Setter Property="Background"
			        Value="{StaticResource Bg4}" />
		</Style>
		<Style Selector="ListBox.connection-functions ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Bg4}" />
		</Style>
		<Style Selector="ListBox.connection-functions ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Bg4}" />
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="Auto,*,Auto,240,Auto">
		<StackPanel Orientation="Horizontal"
		            Spacing="6">
			<TextBlock Text="Signal"
			           Foreground="{StaticResource TextMuted}"
			           FontSize="16"
			           FontWeight="Bold"/>
			<TextBlock Text="{Binding SignalText}"
			           FontSize="16"
			           FontWeight="Bold"/>
		</StackPanel>
		<Grid Grid.Row="1"
		      Margin="0,12,0,0"
		      ColumnDefinitions="*,*"
		      ColumnSpacing="12">
			<Border Background="{StaticResource Bg1}"
			        CornerRadius="8"
			        Padding="8">
				<Grid RowDefinitions="Auto,*"
				      RowSpacing="8">
					<TextBlock Text="Workspace nodes"
					           FontWeight="SemiBold" />
					<TreeView Grid.Row="1"
					          Classes="connection-workspace"
					          ItemsSource="{Binding Nodes}"
					          SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
						<TreeView.ItemTemplate>
							<TreeDataTemplate ItemsSource="{Binding PickerChildren}"
							                  x:DataType="vm:HierarchyElement">
								<StackPanel Orientation="Horizontal"
								            Spacing="6">
									<Border Width="16"
									        Height="16"
									        Background="{Binding Color, Converter={StaticResource BrushFromKey}}">
										<Border.OpacityMask>
											<ImageBrush Source="{Binding SmallIcon}" />
										</Border.OpacityMask>
									</Border>
									<TextBlock Text="{Binding Name}" />
								</StackPanel>
							</TreeDataTemplate>
						</TreeView.ItemTemplate>
					</TreeView>
				</Grid>
			</Border>
			<Border Grid.Column="1"
			        Background="{StaticResource Bg1}"
			        CornerRadius="8"
			        Padding="8">
				<Grid RowDefinitions="Auto,*"
				      RowSpacing="8">
					<TextBlock Text="Functions"
					           FontWeight="SemiBold" />
					<Grid Grid.Row="1">
						<ListBox Classes="connection-functions"
						         ItemsSource="{Binding Functions}"
						         SelectedItem="{Binding SelectedFunction, Mode=TwoWay}"
						         Background="{StaticResource Bg1}">
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="vm:SignalFunctionViewModel">
									<StackPanel Spacing="2">
										<TextBlock Text="{Binding DeclaringClass}"
										           IsVisible="{Binding ShowHeader}"
										           Margin="4,8,0,2"
										           FontSize="11"
										           FontWeight="SemiBold"
										           Foreground="{StaticResource TextMuted}" />
										<Grid ColumnDefinitions="Auto,*"
										      ColumnSpacing="8"
										      IsEnabled="{Binding IsEnabled}"
										      Opacity="{Binding Opacity}"
										      ToolTip.Tip="{Binding DisabledReason}">
											<LucideIcon Kind="SquareFunction"
											            Size="17"
											            Foreground="{Binding Brush}" />
											<TextBlock Grid.Column="1"
											           Text="{Binding Signature}"
											           TextTrimming="CharacterEllipsis" />
										</Grid>
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
						<TextBlock Text="{Binding EmptyMessage}"
						           IsVisible="{Binding !Functions.Count}"
						           Foreground="{StaticResource TextMuted}"
						           HorizontalAlignment="Center"
						           VerticalAlignment="Center"
						           TextAlignment="Center"
						           TextWrapping="Wrap"
						           Margin="16" />
					</Grid>
				</Grid>
			</Border>
		</Grid>
		<GridSplitter Grid.Row="2"
		              ResizeDirection="Rows"
		              ResizeBehavior="PreviousAndNext"
		              Background="Transparent"
		              Height="12" />
		<Border Grid.Row="3"
		        Background="{StaticResource Bg3}"
		        CornerRadius="8"
		        Padding="10">
			<Grid RowDefinitions="Auto,Auto,*"
			      RowSpacing="10">
				<TextBlock Text="Parameters"
				           FontWeight="SemiBold" />
				<StackPanel Grid.Row="1"
				            IsVisible="{Binding HasSignalArgs}">
					<ItemsControl ItemsSource="{Binding SignalArgs}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:SignalArgChip">
								<Border Tag="arg-chip"
								        Classes="arg-chip"
								        BorderThickness="1"
								        CornerRadius="12"
								        Height="24"
								        Padding="6,0,10,0"
								        Margin="0,0,6,4"
								        Cursor="Hand"
								        ToolTip.Tip="Drag onto a parameter">
									<StackPanel Orientation="Horizontal"
									            Spacing="4"
									            VerticalAlignment="Center"
									            IsHitTestVisible="False">
										<LucideIcon Kind="GripVertical"
										            Size="12" />
										<TextBlock Text="{Binding Text}" />
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
				<TextBlock Grid.Row="2"
				           Text="Select a function to bind its parameters"
				           IsVisible="{Binding SelectedFunction, Converter={x:Static ObjectConverters.IsNull}}"
				           Foreground="{StaticResource TextMuted}" />
				<TextBlock Grid.Row="2"
				           Text="This function takes no parameters"
				           IsVisible="{Binding ShowNoParameters}"
				           Foreground="{StaticResource TextMuted}" />
				<ScrollViewer Grid.Row="2"
				              HorizontalScrollBarVisibility="Disabled"
				              IsVisible="{Binding HasParameters}">
					<ItemsControl Classes="params" ItemsSource="{Binding Parameters}"
					              Grid.IsSharedSizeScope="True">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<elements:SpanPanel Columns="3" Spacing="8" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:SignalParameterViewModel">
								<Border Background="{StaticResource Bg4}" CornerRadius="8" Padding="8,6">
								<Grid ColumnDefinitions="Auto,*,Auto"
								      ColumnSpacing="8">
									<StackPanel Orientation="Horizontal"
									            Spacing="6"
									            VerticalAlignment="Center"
									            ToolTip.Tip="{Binding Header}">
										<TextBlock Text="{Binding Name}"
										           FontWeight="SemiBold" />
										<TextBlock Text="{Binding Type}"
										           Foreground="{StaticResource TextMuted}" />
									</StackPanel>
									<Border Grid.Column="1"
									        Tag="param-slot"
									        DragDrop.AllowDrop="True"
									        Background="{StaticResource Bg1}"
									        BorderBrush="{StaticResource Bg2}"
									        BorderThickness="1"
									        CornerRadius="6"
									        ClipToBounds="True"
									        Classes="param-slot"
									        Classes.vec="{Binding IsVector}"
									        Height="36">
										<Panel>
											<Border Classes="arg-chip"
											        IsVisible="{Binding IsBoundToSignal}"
											        HorizontalAlignment="Left"
											        VerticalAlignment="Center"
											        Margin="5,0"
											        BorderThickness="1"
											        CornerRadius="12"
											        Height="24"
											        Padding="8,0,10,0">
												<StackPanel Orientation="Horizontal"
												            Spacing="4"
												            VerticalAlignment="Center">
													<LucideIcon Kind="Cable"
													            Size="12" />
													<TextBlock Text="{Binding BoundText}" />
												</StackPanel>
											</Border>
											<TextBlock Text="Drop a signal parameter here"
											           IsVisible="{Binding ShowSignalOnlyHint}"
											           VerticalAlignment="Center"
											           Margin="8,0"
											           Foreground="{StaticResource TextMuted}" />
											<Grid ColumnDefinitions="Auto,*"
											      IsVisible="{Binding ShowLiteral}">
												<elements:EnumBox Value="{Binding AnyType, Mode=TwoWay}"
												                  Options="{Binding AnyTypes}"
												                  MinWidth="90"
												                  IsVisible="{Binding IsAny}" />
												<Panel Grid.Column="1">
													<elements:BoolBox Value="{Binding BoolValue, Mode=TwoWay}"
													                  IsVisible="{Binding IsBool}" />
													<elements:BoolBox Value="{Binding BoolValue, Mode=TwoWay}"
													                  IsVisible="{Binding IsAnyBool}" />
													<elements:DragIntBox Value="{Binding IntegerValue, Mode=TwoWay}"
													                     IsVisible="{Binding IsInteger}" />
													<elements:DragIntBox Value="{Binding IntegerValue, Mode=TwoWay}"
													                     IsVisible="{Binding IsAnyInteger}" />
													<elements:DragFloatBox Value="{Binding NumberValue, Mode=TwoWay}"
													                       IsVisible="{Binding IsNumber}" />
													<elements:DragFloatBox Value="{Binding NumberValue, Mode=TwoWay}"
													                       IsVisible="{Binding IsAnyNumber}" />
													<elements:StringBox Value="{Binding StringValue, Mode=TwoWay}"
													                    Wrap="False"
													                    IsVisible="{Binding IsString}" />
													<elements:StringBox Value="{Binding StringValue, Mode=TwoWay}"
													                    Wrap="False"
													                    IsVisible="{Binding IsAnyString}" />
													<elements:DragVec2Box X="{Binding X, Mode=TwoWay}"
													                      Y="{Binding Y, Mode=TwoWay}"
													                      IsVisible="{Binding IsVec2}" />
													<elements:DragVec3Box X="{Binding X, Mode=TwoWay}"
													                      Y="{Binding Y, Mode=TwoWay}"
													                      Z="{Binding Z, Mode=TwoWay}"
													                      IsVisible="{Binding IsVec3}" />
													<elements:DragVec4Box X="{Binding X, Mode=TwoWay}"
													                      Y="{Binding Y, Mode=TwoWay}"
													                      Z="{Binding Z, Mode=TwoWay}"
													                      W="{Binding W, Mode=TwoWay}"
													                      IsVisible="{Binding IsVec4}" />
												</Panel>
											</Grid>
										</Panel>
									</Border>
									<Panel Grid.Column="2"
									       Width="36"
									       Height="36">
										<Button Command="{Binding ClearBindingCommand}"
										        IsVisible="{Binding IsBoundToSignal}"
										        Background="{StaticResource Bg5}"
										        Padding="0"
										        CornerRadius="6"
										        Width="36"
										        Height="36"
										        ToolTip.Tip="Remove the binding">
											<LucideIcon Kind="X"
											            Size="14" />
										</Button>
										<Button Command="{Binding UseValueCommand}"
										        IsVisible="{Binding ShowUseValue}"
										        Background="{StaticResource Bg5}"
										        Padding="0"
										        CornerRadius="6"
										        Width="36"
										        Height="36"
										        ToolTip.Tip="Use the value shown here">
											<LucideIcon Kind="Check"
											            Size="14" />
										</Button>
										<LucideIcon Kind="Check"
										            Size="16"
										            IsVisible="{Binding IsLiteralBound}"
										            Foreground="{StaticResource Green}" />
									</Panel>
								</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</Border>
		<StackPanel Grid.Row="4"
		            Margin="0,12,0,0"
		            Orientation="Horizontal"
		            HorizontalAlignment="Right"
		            Spacing="8">
			<Button Content="Cancel"
			        Click="OnCancel"
			        CornerRadius="6"/>
			<Button IsEnabled="{Binding CanAccept}"
			        Click="OnAccept"
			        CornerRadius="6"
			        Background="{StaticResource Red}">
				<StackPanel Orientation="Horizontal"
				            Spacing="6">
					<LucideIcon Kind="Cable"
					            Size="16"
					            StrokeWidth="3"/>
					<TextBlock Text="Connect"
					           FontWeight="Bold"/>
				</StackPanel>
			</Button>
		</StackPanel>
	</Grid>
</Window>
