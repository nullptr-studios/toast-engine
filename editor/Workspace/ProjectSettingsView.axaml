<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:editor.Workspace"
             xmlns:set="using:editor.Settings"
             xmlns:elements="using:editor.Components.Elements"
             xmlns:lucide="using:Lucide.Avalonia"
             xmlns:conv="using:editor.Components.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="980"
             d:DesignHeight="720"
             x:Class="editor.Workspace.ProjectSettingsView"
             Background="{StaticResource Bg2}"
             x:DataType="vm:ProjectSettingsViewModel">

	<Design.DataContext>
		<vm:ProjectSettingsViewModel />
	</Design.DataContext>

	<UserControl.Styles>
		<Style Selector="TextBlock.lbl">
			<Setter Property="Foreground"
			        Value="{StaticResource Text}" />
			<Setter Property="VerticalAlignment"
			        Value="Center" />
			<Setter Property="TextTrimming"
			        Value="CharacterEllipsis" />
		</Style>
		<Style Selector="TextBlock.hint">
			<Setter Property="Foreground"
			        Value="{StaticResource TextMuted}" />
			<Setter Property="FontSize"
			        Value="11" />
			<Setter Property="TextWrapping"
			        Value="Wrap" />
		</Style>
		<Style Selector="TextBlock.unit">
			<Setter Property="Foreground"
			        Value="{StaticResource TextMuted}" />
			<Setter Property="VerticalAlignment"
			        Value="Center" />
			<Setter Property="MinWidth"
			        Value="0" />
		</Style>
		<Style Selector="Border.card">
			<Setter Property="Background"
			        Value="{StaticResource Bg3}" />
			<Setter Property="CornerRadius"
			        Value="8" />
			<Setter Property="Padding"
			        Value="6" />
		</Style>

		<Style Selector="Button.btn">
			<Setter Property="Background"
			        Value="{StaticResource Bg4}" />
			<Setter Property="CornerRadius"
			        Value="6" />
			<Setter Property="BorderThickness"
			        Value="0" />
			<Setter Property="Cursor"
			        Value="Hand" />
			<Setter Property="VerticalAlignment"
			        Value="Center" />
		</Style>
		<Style Selector="Button.reset">
			<Setter Property="Background"
			        Value="Transparent" />
			<Setter Property="BorderThickness"
			        Value="0" />
			<Setter Property="Padding"
			        Value="0" />
			<Setter Property="Width"
			        Value="20" />
			<Setter Property="Height"
			        Value="20" />
			<Setter Property="MinHeight"
			        Value="0" />
			<Setter Property="CornerRadius"
			        Value="6" />
			<Setter Property="VerticalAlignment"
			        Value="Center" />
			<Setter Property="Cursor"
			        Value="Hand" />
		</Style>

		<Style Selector="Border.nav">
			<Setter Property="Background"
			        Value="Transparent" />
			<Setter Property="BorderBrush"
			        Value="Transparent" />
			<Setter Property="BorderThickness"
			        Value="2" />
			<Setter Property="CornerRadius"
			        Value="8" />
			<Setter Property="Height"
			        Value="26" />
			<Setter Property="Cursor"
			        Value="Hand" />
		</Style>
		<Style Selector="Border.nav:pointerover">
			<Setter Property="Background"
			        Value="{StaticResource Bg3}" />
		</Style>
		<Style Selector="Border.nav.selected">
			<Setter Property="BorderBrush"
			        Value="{StaticResource Bg4}" />
		</Style>
		<Style Selector="TextBlock.navname.selected">
			<Setter Property="FontWeight"
			        Value="SemiBold" />
		</Style>

		<!-- collapsible header -->
		<Style Selector="ToggleButton.hdr">
			<Setter Property="Background"
			        Value="Transparent" />
			<Setter Property="BorderThickness"
			        Value="0" />
			<Setter Property="Padding"
			        Value="4" />
			<Setter Property="HorizontalAlignment"
			        Value="Stretch" />
			<Setter Property="HorizontalContentAlignment"
			        Value="Stretch" />
			<Setter Property="Foreground"
			        Value="{StaticResource Text}" />
			<Setter Property="Cursor"
			        Value="Hand" />
		</Style>
		<Style Selector="ToggleButton.hdr /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="Transparent" />
			<Setter Property="CornerRadius"
			        Value="6" />
		</Style>
		<Style Selector="ToggleButton.hdr:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Bg4}" />
		</Style>
		<Style Selector="ToggleButton.hdr:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Bg4}" />
		</Style>
		<Style Selector="TextBlock.group">
			<Setter Property="FontWeight"
			        Value="Bold" />
		</Style>
		<Style Selector="TextBlock.subgroup">
			<Setter Property="Foreground"
			        Value="{StaticResource TextMuted}" />
			<Setter Property="FontWeight"
			        Value="SemiBold" />
		</Style>
	</UserControl.Styles>

	<UserControl.Resources>
		<conv:ResourceBrushConverter x:Key="BrushFromKey" />

		<DataTemplate x:Key="SettingRowTemplate"
		              x:DataType="set:SettingRow">
			<Grid ColumnDefinitions="230,*"
			      ColumnSpacing="6"
			      Margin="0,0,0,3"
			      ToolTip.Tip="{Binding Tooltip}">
				<StackPanel Grid.Column="0"
				            Orientation="Horizontal"
				            Spacing="6"
				            VerticalAlignment="Top"
				            Margin="0,5,0,0">
					<TextBlock Text="{Binding Label}"
					           Classes="lbl compact-text" />
					<TextBlock Text="restart"
					           Classes="hint compact-text"
					           VerticalAlignment="Center"
					           IsVisible="{Binding RequiresRestart}" />
				</StackPanel>

				<StackPanel Grid.Column="1">
					<Grid ColumnDefinitions="*,22"
					      ColumnSpacing="6">
						<ContentControl Grid.Column="0"
						                Content="{Binding}" />
						<Button Grid.Column="1"
						        Classes="reset"
						        VerticalAlignment="Top"
						        Margin="0,4,0,0"
						        Command="{Binding ResetCommand}"
						        IsVisible="{Binding IsOverridden}"
						        ToolTip.Tip="Back to the default">
							<lucide:LucideIcon Kind="Undo2"
							                   Size="14"
							                   StrokeWidth="2.5" />
						</Button>
					</Grid>
					<TextBlock Text="{Binding Error}"
					           Classes="hint compact-text"
					           Foreground="{StaticResource Red}"
					           IsVisible="{Binding HasError}" />
				</StackPanel>
			</Grid>
		</DataTemplate>

		<DataTemplate x:Key="SettingCardTemplate"
		              x:DataType="vm:SettingsCardViewModel">
			<Border Classes="card"
			        Margin="0,0,0,2"
			        Padding="4">
				<StackPanel>
					<ToggleButton Classes="hdr compact-control"
					              IsChecked="{Binding Expanded, Mode=TwoWay}">
						<StackPanel Orientation="Horizontal"
						            Spacing="4">
							<Border Width="3"
							        Height="14"
							        CornerRadius="2"
							        VerticalAlignment="Center"
							        Background="{Binding ColorKey, Converter={StaticResource BrushFromKey}}" />
							<TextBlock Classes="group compact-text"
							           Text="{Binding Title}" />
						</StackPanel>
					</ToggleButton>

					<elements:AnimatedReveal IsExpanded="{Binding Expanded}">
						<StackPanel Margin="10,4,0,0">
							<StackPanel IsVisible="{Binding HasInfo}">
							<StackPanel DataContext="{Binding Info}">
								<Grid ColumnDefinitions="230,*"
								      ColumnSpacing="6"
								      Margin="0,0,0,3">
									<TextBlock Text="Name"
									           Classes="lbl compact-text"
									           VerticalAlignment="Top"
									           Margin="0,5,0,0" />
									<elements:StringBox Grid.Column="1"
									                    Value="{Binding Name, Mode=TwoWay}"
									                    Wrap="False"
									                    Classes="compact-field" />
								</Grid>
								<Grid ColumnDefinitions="230,*"
								      ColumnSpacing="6"
								      Margin="0,0,0,3">
									<TextBlock Text="Version"
									           Classes="lbl compact-text"
									           VerticalAlignment="Top"
									           Margin="0,5,0,0" />
									<Grid Grid.Column="1"
									      ColumnDefinitions="*,*,*,28"
									      ColumnSpacing="4">
										<elements:DragIntBox Grid.Column="0"
										                     Value="{Binding Major, Mode=TwoWay}"
										                     Minimum="0"
										                     Classes="compact-field" />
										<elements:DragIntBox Grid.Column="1"
										                     Value="{Binding Minor, Mode=TwoWay}"
										                     Minimum="0"
										                     Classes="compact-field" />
										<elements:DragIntBox Grid.Column="2"
										                     Value="{Binding Patch, Mode=TwoWay}"
										                     Minimum="0"
										                     Classes="compact-field" />
									</Grid>
								</Grid>
								<TextBlock Classes="hint compact-text"
								           Text="{Binding Status}"
								           Foreground="{StaticResource Red}" />
							</StackPanel>
							</StackPanel>

							<ItemsControl ItemsSource="{Binding Normal}"
							              Margin="0,2,0,0"
							              ItemTemplate="{StaticResource SettingRowTemplate}" />

							<StackPanel IsVisible="{Binding HasAdvanced}">
								<ToggleButton Classes="hdr compact-control"
								              Margin="-6,0,0,0"
								              IsChecked="{Binding AdvancedExpanded, Mode=TwoWay}">
									<TextBlock Classes="subgroup compact-text"
									           Text="Advanced" />
								</ToggleButton>
								<elements:AnimatedReveal IsExpanded="{Binding AdvancedExpanded}">
									<ItemsControl ItemsSource="{Binding Advanced}"
									              Margin="0,4,0,0"
									              ItemTemplate="{StaticResource SettingRowTemplate}" />
								</elements:AnimatedReveal>
							</StackPanel>

							<StackPanel IsVisible="{Binding HasDebug}">
								<ToggleButton Classes="hdr compact-control"
								              Margin="-6,0,0,0"
								              IsChecked="{Binding DebugExpanded, Mode=TwoWay}">
									<TextBlock Classes="subgroup compact-text"
									           Text="Debug" />
								</ToggleButton>
								<elements:AnimatedReveal IsExpanded="{Binding DebugExpanded}">
									<ItemsControl ItemsSource="{Binding Debug}"
									              Margin="0,4,0,0"
									              ItemTemplate="{StaticResource SettingRowTemplate}" />
								</elements:AnimatedReveal>
							</StackPanel>
						</StackPanel>
					</elements:AnimatedReveal>
				</StackPanel>
			</Border>
		</DataTemplate>
	</UserControl.Resources>

	<UserControl.DataTemplates>
		<DataTemplate DataType="set:BoolSettingRow">
			<elements:BoolBox Value="{Binding Value, Mode=TwoWay}"
			                  Classes="compact-field" />
		</DataTemplate>

		<DataTemplate DataType="set:IntSettingRow">
			<elements:DragIntBox Value="{Binding Value, Mode=TwoWay}"
			                     Minimum="{Binding Minimum}"
			                     Maximum="{Binding Maximum}"
			                     Unit="{Binding Unit}"
			                     Classes="compact-field" />
		</DataTemplate>

		<DataTemplate DataType="set:FloatSettingRow">
			<elements:DragFloatBox Value="{Binding Value, Mode=TwoWay}"
			                       Minimum="{Binding Minimum}"
			                       Maximum="{Binding Maximum}"
			                       Unit="{Binding Unit}"
			                       Classes="compact-field" />
		</DataTemplate>

		<DataTemplate DataType="set:ChoiceSettingRow">
			<elements:EnumBox Value="{Binding SelectedName, Mode=TwoWay}"
			                  Options="{Binding Options}"
			                  Classes="compact-field" />
		</DataTemplate>

		<DataTemplate DataType="set:TextSettingRow">
			<elements:StringBox Value="{Binding Value, Mode=TwoWay}"
			                    Wrap="False"
			                    Classes="compact-field" />
		</DataTemplate>

		<DataTemplate DataType="set:AssetSettingRow">
			<elements:AssetBox Value="{Binding Value, Mode=TwoWay}"
			                   AssetType="{Binding AssetType}"
			                   Classes="compact-field" />
		</DataTemplate>

		<DataTemplate DataType="set:VectorSettingRow">
			<Panel>
				<elements:DragVec2Box X="{Binding X, Mode=TwoWay}"
				                      Y="{Binding Y, Mode=TwoWay}"
				                      Unit="{Binding Unit}"
				                      IsVisible="{Binding IsVec2}"
				                      Classes="compact-vector" />
				<elements:DragVec3Box X="{Binding X, Mode=TwoWay}"
				                      Y="{Binding Y, Mode=TwoWay}"
				                      Z="{Binding Z, Mode=TwoWay}"
				                      Unit="{Binding Unit}"
				                      IsVisible="{Binding IsVec3}"
				                      Classes="compact-vector" />
				<elements:DragVec4Box X="{Binding X, Mode=TwoWay}"
				                      Y="{Binding Y, Mode=TwoWay}"
				                      Z="{Binding Z, Mode=TwoWay}"
				                      W="{Binding W, Mode=TwoWay}"
				                      Unit="{Binding Unit}"
				                      IsVisible="{Binding IsVec4}"
				                      Classes="compact-vector" />
			</Panel>
		</DataTemplate>

		<DataTemplate DataType="set:ArraySettingRow">
			<elements:ArrayBox Background="{StaticResource Bg1}"
			                   Padding="6"
			                   Items="{Binding Items}"
			                   AddLabel="Add"
			                   AddCommand="{Binding AddCommand}"
			                   CanReorder="True"
			                   CanAddRemove="True"
			                   Classes="compact-array">
				<elements:ArrayBox.ItemTemplate>
					<DataTemplate x:DataType="set:ArrayItem">
						<elements:StringBox Value="{Binding Text, Mode=TwoWay}"
						                    Wrap="False"
						                    Classes="compact-field" />
					</DataTemplate>
				</elements:ArrayBox.ItemTemplate>
			</elements:ArrayBox>
		</DataTemplate>
	</UserControl.DataTemplates>

	<Grid x:Name="Columns"
	      ColumnDefinitions="190,4,*"
	      Margin="8">

		<Border Grid.Column="0"
		        Classes="card">
			<ScrollViewer HorizontalScrollBarVisibility="Disabled">
				<ItemsControl ItemsSource="{Binding NavRows}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:SettingsNavItem">
							<Border Classes="nav"
							        Classes.selected="{Binding IsSelected}"
							        PointerPressed="OnNavPressed">
								<Grid ColumnDefinitions="Auto,Auto,*"
								      Margin="{Binding Indent}">
									<Border Grid.Column="0"
									        Width="16"
									        Background="Transparent"
									        PointerPressed="OnNavChevronPressed">
										<Panel IsVisible="{Binding HasChildren}">
											<lucide:LucideIcon Kind="ChevronDown"
											                   Size="14"
											                   StrokeWidth="2.5"
											                   IsVisible="{Binding IsExpanded}" />
											<lucide:LucideIcon Kind="ChevronRight"
											                   Size="14"
											                   StrokeWidth="2.5"
											                   IsVisible="{Binding !IsExpanded}" />
										</Panel>
									</Border>
									<TextBlock Grid.Column="2"
									           Text="{Binding Name}"
									           Classes="navname compact-text"
									           Classes.selected="{Binding IsSelected}"
									           VerticalAlignment="Center"
									           Margin="6,0,0,0"
									           TextTrimming="CharacterEllipsis" />
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Border>

		<GridSplitter x:Name="NavSplitter"
		              Grid.Column="1"
		              Background="Transparent"
		              ResizeDirection="Columns" />

		<Border Grid.Column="2"
		        Classes="card">
			<DockPanel LastChildFill="True">

				<DockPanel DockPanel.Dock="Top"
				           Margin="0,0,0,8">
					<StackPanel DockPanel.Dock="Right"
					            Orientation="Horizontal"
					            Spacing="4">
						<Button Classes="btn compact-control"
						        Command="{Binding ReloadCommand}"
						        ToolTip.Tip="Read every parameter from the engine again">
							<lucide:LucideIcon Kind="RefreshCw"
							                   Size="16"
							                   StrokeWidth="2.5" />
						</Button>
						<Button Classes="btn compact-control"
						        Command="{Binding ResetAllCommand}"
						        IsVisible="{Binding ShowCards}"
						        ToolTip.Tip="Every parameter back to its default">
							<lucide:LucideIcon Kind="Undo2"
							                   Size="16"
							                   StrokeWidth="2.5" />
						</Button>
						<Button Classes="btn compact-control"
						        Command="{Binding SaveCommand}"
						        IsVisible="{Binding ShowCards}"
						        ToolTip.Tip="Write the changes to the project's config files">
							<lucide:LucideIcon Kind="Save"
							                   Size="16"
							                   StrokeWidth="2.5" />
						</Button>
					</StackPanel>
					<TextBlock Text="{Binding SectionTitle}"
					           Classes="group"
					           VerticalAlignment="Center"
					           FontSize="13" />
				</DockPanel>

				<TextBox DockPanel.Dock="Top"
				         Text="{Binding SearchText, Mode=TwoWay}"
				         PlaceholderText="Filter properties"
				         IsVisible="{Binding ShowCards}"
				         VerticalContentAlignment="Center"
				         CornerRadius="6"
				         BorderThickness="0"
				         Background="{StaticResource Bg1}"
				         Margin="0,0,0,8"
				         Classes="compact-control" />

				<TextBlock DockPanel.Dock="Bottom"
				           Classes="hint compact-text"
				           Text="{Binding StatusMessage}"
				           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

				<Panel>
					<ScrollViewer>
						<StackPanel Spacing="0">

							<Border Classes="card"
							        Margin="0,0,0,8"
							        IsVisible="{Binding ShowBaking}">
								<StackPanel Spacing="4">
									<TextBlock Text="Baking"
									           Classes="group compact-text" />
									<StackPanel Orientation="Horizontal"
									            Spacing="4">
										<Button Content="Reflection probes"
										        Command="{Binding BakeReflectionProbesCommand}"
										        Classes="btn compact-control" />
										<Button Content="Irradiance volumes"
										        Command="{Binding BakeIrradianceVolumesCommand}"
										        Classes="btn compact-control" />
									</StackPanel>
									<TextBlock Classes="hint compact-text"
									           Text="Some reflection probes are stale"
									           IsVisible="{Binding HasStaleReflectionProbes}" />
									<TextBlock Classes="hint compact-text"
									           Text="Some irradiance volumes are stale"
									           IsVisible="{Binding HasStaleIrradianceVolumes}" />
									<TextBlock Classes="hint compact-text"
									           Text="This device has no ray query, so traced shadows do nothing"
									           IsVisible="{Binding !RayTracingSupported}" />
								</StackPanel>
							</Border>

							<ItemsControl ItemsSource="{Binding Cards}"
							              IsVisible="{Binding ShowCards}"
							              ItemTemplate="{StaticResource SettingCardTemplate}" />

							<TextBlock Classes="hint compact-text"
							           Text="{Binding EmptyMessage}"
							           IsVisible="{Binding NothingToShow}" />

							<vm:AssetBrowserSettingsView DataContext="{Binding AssetBrowser}"
							                             IsVisible="{Binding $parent[UserControl].((vm:ProjectSettingsViewModel)DataContext).ShowAssetBrowser}" />

							<!-- physics > Layers -->
							<Border Classes="card"
							        IsVisible="{Binding ShowPhysicsLayers}">
								<StackPanel Spacing="4">
									<TextBlock Text="Layers"
									           Classes="group compact-text" />
									<TextBlock Classes="hint compact-text"
									           Text="Names and short names for the collision layers. Layer 0 is always Default." />

									<ItemsControl ItemsSource="{Binding PhysicsLayers.Layers}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="vm:PhysicsLayerRow">
												<Grid ColumnDefinitions="32,72,*"
												      ColumnSpacing="4"
												      Margin="0,0,0,4">
													<TextBlock Grid.Column="0"
													           Text="{Binding Index}"
													           Classes="lbl compact-text"
													           HorizontalAlignment="Right" />
													<TextBox Grid.Column="1"
													         Text="{Binding Abbreviation, Mode=TwoWay}"
													         MaxLength="3"
													         IsEnabled="{Binding Editable}"
													         PlaceholderText="Abbr"
													         FontWeight="Bold"
													         HorizontalContentAlignment="Center"
													         VerticalContentAlignment="Center"
													         CornerRadius="6"
													         BorderThickness="0"
													         Background="{StaticResource Bg1}"
													         Classes="compact-control" />
													<TextBox Grid.Column="2"
													         Text="{Binding Name, Mode=TwoWay}"
													         IsEnabled="{Binding Editable}"
													         PlaceholderText="Layer name"
													         VerticalContentAlignment="Center"
													         CornerRadius="6"
													         BorderThickness="0"
													         Background="{StaticResource Bg1}"
													         Classes="compact-control" />
												</Grid>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Border>
						</StackPanel>
					</ScrollViewer>

				</Panel>
			</DockPanel>
		</Border>
	</Grid>
</UserControl>
