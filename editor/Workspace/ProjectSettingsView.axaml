<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:editor.Workspace"
             xmlns:editors="using:editor.Editors"
             xmlns:elements="using:editor.Components.Elements"
             xmlns:lucide="using:Lucide.Avalonia"
             xmlns:assets="using:editor.Assets"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="800"
             x:Class="editor.Workspace.ProjectSettingsView"
             Background="{StaticResource Bg2}"
             x:DataType="vm:ProjectSettingsViewModel">

	<Design.DataContext>
		<vm:ProjectSettingsViewModel />
	</Design.DataContext>

	<UserControl.Styles>
		<Style Selector="TextBlock.lbl">
			<Setter Property="Foreground"
			        Value="{StaticResource TextMuted}" />
			<Setter Property="VerticalAlignment"
			        Value="Center" />
			<Setter Property="TextTrimming"
			        Value="CharacterEllipsis" />
		</Style>
		<Style Selector="TextBlock.hint">
			<Setter Property="Foreground"
			        Value="{StaticResource TextMuted}" />
			<Setter Property="FontSize"
			        Value="11" />
			<Setter Property="TextWrapping"
			        Value="Wrap" />
			<Setter Property="Margin"
			        Value="0,2,0,0" />
		</Style>
		<Style Selector="TextBlock.category">
			<Setter Property="FontWeight"
			        Value="SemiBold" />
			<Setter Property="VerticalAlignment"
			        Value="Center" />
		</Style>
		<Style Selector="Border.card">
			<Setter Property="Background"
			        Value="{StaticResource Bg3}" />
			<Setter Property="CornerRadius"
			        Value="8" />
			<Setter Property="Padding"
			        Value="6" />
		</Style>
		<Style Selector="Button.icon-btn">
			<Setter Property="BorderThickness"
			        Value="0" />
			<Setter Property="Padding"
			        Value="5" />
			<Setter Property="CornerRadius"
			        Value="6" />
			<Setter Property="Cursor"
			        Value="Hand" />
			<Setter Property="Background"
			        Value="Transparent" />
			<Setter Property="VerticalAlignment"
			        Value="Center" />
		</Style>
	</UserControl.Styles>

	<UserControl.DataTemplates>
		<DataTemplate DataType="vm:BoolSettingRow">
			<elements:BoolBox Value="{Binding Value, Mode=TwoWay}" Classes="compact-field" />
		</DataTemplate>

		<DataTemplate DataType="vm:EnumSettingRow">
			<ComboBox ItemsSource="{Binding Options}"
			          SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
			          HorizontalAlignment="Stretch" Classes="compact-control" />
		</DataTemplate>

		<DataTemplate DataType="vm:IntSettingRow">
			<elements:DragIntBox Value="{Binding IntValue, Mode=TwoWay}"
			                     Minimum="{Binding MinimumDouble}"
			                     Maximum="{Binding MaximumDouble}" Classes="compact-field" />
		</DataTemplate>

		<DataTemplate DataType="vm:FloatSettingRow">
			<elements:DragFloatBox Value="{Binding FloatValue, Mode=TwoWay}"
			                       Minimum="{Binding Minimum}"
			                       Maximum="{Binding Maximum}" Classes="compact-field" />
		</DataTemplate>

		<DataTemplate DataType="vm:Vec3SettingRow">
			<elements:DragVec3Box X="{Binding X, Mode=TwoWay}"
			                      Y="{Binding Y, Mode=TwoWay}"
			                      Z="{Binding Z, Mode=TwoWay}" Classes="compact-vector" />
		</DataTemplate>

		<DataTemplate DataType="vm:AssetSettingRow">
			<elements:AssetBox Value="{Binding Value, Mode=TwoWay}"
			                   AssetType="{Binding AssetType}" Classes="compact-field" />
		</DataTemplate>

		<DataTemplate DataType="vm:StringSettingRow">
			<elements:StringBox Value="{Binding Value, Mode=TwoWay}"
			                    Wrap="False" Classes="compact-field" />
		</DataTemplate>
	</UserControl.DataTemplates>

	<Grid ColumnDefinitions="0.2*,4,0.8*"
	      Margin="8">

		<Border Grid.Column="0"
		       Classes="card">
			<TreeView ItemsSource="{Binding Sections}"
			          SelectedItem="{Binding SelectedSection, Mode=TwoWay}">
				<TreeView.ItemTemplate>
					<TreeDataTemplate ItemsSource="{Binding Children}"
					                  x:DataType="vm:SettingsSection">
						<TextBlock Text="{Binding Name}"
						           VerticalAlignment="Center" Classes="compact-text" />
					</TreeDataTemplate>
				</TreeView.ItemTemplate>
			</TreeView>
		</Border>

		<GridSplitter Grid.Column="1"
		              Background="Transparent"
		              ResizeDirection="Columns" />

		<Border Grid.Column="2"
		       Classes="card">
			<DockPanel LastChildFill="True">

				<DockPanel DockPanel.Dock="Top"
				           Margin="0,0,0,8">
					<StackPanel DockPanel.Dock="Right"
					            Orientation="Horizontal"
					            Spacing="4">
						<Button Classes="icon-btn compact-control"
						        Command="{Binding ReloadCommand}"
						        ToolTip.Tip="Re-read every setting from the engine">
							<lucide:LucideIcon Kind="RefreshCw"
							                   Size="16"
							                   StrokeWidth="2.5" />
						</Button>
						<Button Classes="icon-btn compact-control"
						        Command="{Binding ResetAllCommand}"
						        IsVisible="{Binding IsEngineTab}"
						        ToolTip.Tip="Drop every override, exposing the defaults underneath">
							<lucide:LucideIcon Kind="Undo2"
							                   Size="16"
							                   StrokeWidth="2.5" />
						</Button>
						<Button Classes="icon-btn compact-control"
						        Command="{Binding SaveCommand}"
						        IsVisible="{Binding IsEngineTab}"
						        Background="{StaticResource Red}"
						        ToolTip.Tip="Write the project settings layer">
							<lucide:LucideIcon Kind="Save"
							                   Size="16"
							                   StrokeWidth="2.5" />
						</Button>
					</StackPanel>
					<TextBlock Text="{Binding SelectedSection.Name}"
					          Classes="category"
					           FontSize="13" />
				</DockPanel>

				<TextBlock DockPanel.Dock="Bottom"
				          Classes="hint compact-text"
				           Text="{Binding StatusMessage}"
				           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

				<Panel>

					<editors:GenericView DataContext="{Binding GeneralEditor}"
					                     IsVisible="{Binding $parent[UserControl].((vm:ProjectSettingsViewModel)DataContext).IsGeneral}" />

					
					<ScrollViewer IsVisible="{Binding IsEngineTab}">
						<StackPanel Spacing="12">

							
							<Border Classes="card"
							        IsVisible="{Binding IsRendering}">
								<StackPanel Spacing="4">
									<TextBlock Text="Baking"
									          Classes="category compact-text" />
									<StackPanel Orientation="Horizontal"
									            Spacing="4">
										<Button Content="Reflection probes"
										        Command="{Binding BakeReflectionProbesCommand}" Classes="compact-control" />
										<Button Content="Irradiance volumes"
										        Command="{Binding BakeIrradianceVolumesCommand}" Classes="compact-control" />
									</StackPanel>
									<TextBlock Classes="hint compact-text"
									           Text="Some reflection probes are stale"
									           IsVisible="{Binding HasStaleReflectionProbes}" />
									<TextBlock Classes="hint compact-text"
									           Text="Some irradiance volumes are stale"
									           IsVisible="{Binding HasStaleIrradianceVolumes}" />
									<TextBlock Classes="hint compact-text"
									           Text="This device has no ray query, so traced shadows do nothing"
									           IsVisible="{Binding !RayTracingSupported}" />
								</StackPanel>
							</Border>

							<ItemsControl ItemsSource="{Binding VisibleCategories}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:SettingCategory">
										<Border Classes="card"
										        Margin="0,0,0,8">
											<StackPanel Spacing="4">
												<TextBlock Text="{Binding Name}"
												          Classes="category compact-text" />

												<ItemsControl ItemsSource="{Binding Rows}">
													<ItemsControl.ItemTemplate>
														<DataTemplate x:DataType="vm:SettingRow">
															<Grid ColumnDefinitions="180,*,Auto"
															      ColumnSpacing="4"
															      Margin="0,0,0,6">
																<StackPanel Grid.Column="0"
																            VerticalAlignment="Center">
																	<TextBlock Text="{Binding Label}"
																	          Classes="lbl compact-text" />
																	<TextBlock Text="Needs a restart"
																	          Classes="hint compact-text"
																	           IsVisible="{Binding RequiresRestart}" />
																</StackPanel>

																<StackPanel Grid.Column="1"
																            VerticalAlignment="Center">
																	<ContentControl Content="{Binding}" />
																	<TextBlock Text="{Binding Description}"
																	          Classes="hint compact-text"
																	           IsVisible="{Binding HasDescription}" />
																</StackPanel>

																<Button Grid.Column="2"
																       Classes="icon-btn compact-control"
																        Command="{Binding ResetCommand}"
																        ToolTip.Tip="Drop this override">
																	<lucide:LucideIcon Kind="Undo2"
																	                   Size="14"
																	                   StrokeWidth="2.5" />
																</Button>
															</Grid>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<Panel IsVisible="{Binding IsSettingList}">
								<TextBlock Classes="hint compact-text"
								           Text="Nothing declared under this prefix yet - open a workspace so the system starts."
								           IsVisible="{Binding !VisibleCategories.Count}" />
							</Panel>

							<!-- Physics > Tags -->
							<Border Classes="card"
							        IsVisible="{Binding IsPhysicsTags}">
								<StackPanel Spacing="4">
									<StackPanel>
										<TextBlock Text="Layers"
										          Classes="category compact-text" />
									</StackPanel>

									<ItemsControl ItemsSource="{Binding PhysicsLayers.Layers}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="vm:PhysicsLayerRow">
												<Grid ColumnDefinitions="32,72,*"
												      ColumnSpacing="4"
												      Margin="0,0,0,4">
													<TextBlock Grid.Column="0"
													           Text="{Binding Index}"
													          Classes="lbl compact-text"
													           HorizontalAlignment="Right" />
													<TextBox Grid.Column="1"
													         Text="{Binding Abbreviation, Mode=TwoWay}"
													         MaxLength="3"
													         IsEnabled="{Binding Editable}"
													         PlaceholderText="Abbr"
													         FontWeight="Bold"
													         HorizontalContentAlignment="Center"
													         VerticalContentAlignment="Center"
													         CornerRadius="6"
													         BorderThickness="0"
													         Background="{StaticResource Bg1}" Classes="compact-control" />
													<TextBox Grid.Column="2"
													         Text="{Binding Name, Mode=TwoWay}"
													         IsEnabled="{Binding Editable}"
													         PlaceholderText="Layer name"
													         VerticalContentAlignment="Center"
													         CornerRadius="6"
													         BorderThickness="0"
													         Background="{StaticResource Bg1}" Classes="compact-control" />
												</Grid>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Border>
						</StackPanel>
					</ScrollViewer>

					<!-- Editor > Asset Browser -->
					<ScrollViewer IsVisible="{Binding IsEditor}">
						<ContentControl Content="{Binding AssetBrowser}">
							<ContentControl.ContentTemplate>
								<DataTemplate x:DataType="vm:AssetBrowserSettingsViewModel">
									<StackPanel Spacing="12">

										<!-- Tags -->
										<Border Classes="card">
											<StackPanel Spacing="4">
												<DockPanel>
													<Button DockPanel.Dock="Right"
													        Command="{Binding AddTagCommand}"
													        CornerRadius="6"
													        Background="{StaticResource Red}" Classes="compact-control">
														<StackPanel Orientation="Horizontal"
														            Spacing="4">
															<lucide:LucideIcon Kind="Plus"
															                   Size="14"
															                   StrokeWidth="3" />
															<TextBlock Text="Add tag"
															           FontWeight="SemiBold" Classes="compact-text" />
														</StackPanel>
													</Button>
													<StackPanel>
														<TextBlock Text="Tags"
														          Classes="category compact-text" />
														<TextBlock Classes="hint compact-text"
														           Text="Right click an asset and open Tags to assign them. The order here is the order chips appear on the cards." />
													</StackPanel>
												</DockPanel>

												<ItemsControl ItemsSource="{Binding Tags}">
													<ItemsControl.ItemTemplate>
														<DataTemplate x:DataType="assets:AssetTag">
															<Grid ColumnDefinitions="Auto,Auto,Auto,*,90,Auto"
															      ColumnSpacing="4"
															      Margin="0,0,0,4">
																<Button Grid.Column="0"
																       Classes="icon-btn compact-control"
																        Command="{Binding $parent[ItemsControl].((vm:AssetBrowserSettingsViewModel)DataContext).MoveUpCommand}"
																        CommandParameter="{Binding}"
																        ToolTip.Tip="Move up">
																	<lucide:LucideIcon Kind="ChevronUp"
																	                   Size="14"
																	                   StrokeWidth="2.5" />
																</Button>
																<Button Grid.Column="1"
																       Classes="icon-btn compact-control"
																        Command="{Binding $parent[ItemsControl].((vm:AssetBrowserSettingsViewModel)DataContext).MoveDownCommand}"
																        CommandParameter="{Binding}"
																        ToolTip.Tip="Move down">
																	<lucide:LucideIcon Kind="ChevronDown"
																	                   Size="14"
																	                   StrokeWidth="2.5" />
																</Button>
																<Button Grid.Column="2"
																        Width="22"
																        Height="22"
																        Padding="0"
																        CornerRadius="100"
																        VerticalAlignment="Center"
																        BorderThickness="2"
																        BorderBrush="{StaticResource Bg4}"
																        Background="{Binding Brush}"
																        ToolTip.Tip="Color" Classes="compact-control compact-small">
															<Button.Styles>
																<Style Selector="Button:pointerover /template/ Border#ColorBorder">
																	<Setter Property="BorderBrush"
																	        Value="{StaticResource Text}" />
																</Style>
															</Button.Styles>
															<Button.Template>
																<ControlTemplate>
																	<Border Name="ColorBorder"
																	        Background="{TemplateBinding Background}"
																	        BorderBrush="{TemplateBinding BorderBrush}"
																	        BorderThickness="{TemplateBinding BorderThickness}"
																	        CornerRadius="{TemplateBinding CornerRadius}" />
																</ControlTemplate>
															</Button.Template>
																	<Button.Flyout>
																		<Flyout Placement="BottomEdgeAlignedLeft">
																			<ColorView Color="{Binding Color, Mode=TwoWay}"
																			           Palette="{x:Static elements:EditorColorPalette.Instance}"
																			           IsAlphaEnabled="False"
																			           IsAlphaVisible="False"
																			           IsColorPaletteVisible="True"
																			           SelectedIndex="1" />
																		</Flyout>
																	</Button.Flyout>
																</Button>
																<TextBox Grid.Column="3"
																         Text="{Binding Name, Mode=TwoWay}"
																         PlaceholderText="Tag name"
																         VerticalContentAlignment="Center"
																         CornerRadius="6"
																         BorderThickness="0"
																         Background="{StaticResource Bg1}" Classes="compact-control" />
																<TextBlock Grid.Column="4"
																           Text="{Binding AssetCountText}"
																          Classes="lbl"
																           FontSize="12"
																           HorizontalAlignment="Right" />
																<Button Grid.Column="5"
																       Classes="icon-btn compact-control"
																        Command="{Binding $parent[ItemsControl].((vm:AssetBrowserSettingsViewModel)DataContext).RemoveTagCommand}"
																        CommandParameter="{Binding}"
																        ToolTip.Tip="Remove tag">
																	<lucide:LucideIcon Kind="X"
																	                   Size="14"
																	                   StrokeWidth="2.5" />
																</Button>
															</Grid>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>

												<TextBlock Classes="hint compact-text"
												           Text="No tags yet."
												           IsVisible="{Binding !HasTags}" />
											</StackPanel>
										</Border>

										<!-- Display -->
										<Border Classes="card">
											<StackPanel Spacing="4">
												<TextBlock Text="Display"
												          Classes="category compact-text" />
												<Grid ColumnDefinitions="180,*"
												      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
												      ColumnSpacing="4"
												      RowSpacing="4">
													<TextBlock Grid.Row="0"
													           Text="Show tags"
													          Classes="lbl compact-text" />
													<StackPanel Grid.Row="0"
													            Grid.Column="1">
														<elements:BoolBox Value="{Binding ShowTags, Mode=TwoWay}" Classes="compact-field" />
														<TextBlock Classes="hint compact-text"
														           Text="Tag chips under the name of each asset card" />
													</StackPanel>

													<TextBlock Grid.Row="1"
													           Text="Show type badge"
													          Classes="lbl compact-text" />
													<StackPanel Grid.Row="1"
													            Grid.Column="1">
														<elements:BoolBox Value="{Binding ShowTypeBadge, Mode=TwoWay}" Classes="compact-field" />
														<TextBlock Classes="hint compact-text"
														           Text="The colored type chip over each preview" />
													</StackPanel>

													<TextBlock Grid.Row="2"
													           Text="Card size"
													          Classes="lbl compact-text" />
													<ComboBox Grid.Row="2"
													          Grid.Column="1"
													          ItemsSource="{Binding CardSizes}"
													          SelectedIndex="{Binding CardSizeIndex, Mode=TwoWay}"
													          HorizontalAlignment="Stretch" Classes="compact-control" />

													<TextBlock Grid.Row="3"
													           Text="Show core://"
													          Classes="lbl compact-text" />
													<StackPanel Grid.Row="3"
													            Grid.Column="1">
														<elements:BoolBox Value="{Binding ShowCore, Mode=TwoWay}" Classes="compact-field" />
														<TextBlock Classes="hint compact-text"
														           Text="The read-only engine assets" />
													</StackPanel>

													<TextBlock Grid.Row="4"
													           Text="Show cache://"
													          Classes="lbl compact-text" />
													<StackPanel Grid.Row="4"
													            Grid.Column="1">
														<elements:BoolBox Value="{Binding ShowCache, Mode=TwoWay}" Classes="compact-field" />
														<TextBlock Classes="hint compact-text"
														           Text="Files the engine generates: manifests, thumbnails, compiled output" />
													</StackPanel>
												</Grid>
											</StackPanel>
										</Border>

										<!-- Behaviour -->
										<Border Classes="card">
											<StackPanel Spacing="4">
												<TextBlock Text="Behaviour"
												          Classes="category compact-text" />
												<Grid ColumnDefinitions="180,*"
												      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
												      ColumnSpacing="4"
												      RowSpacing="4">
													<TextBlock Grid.Row="0"
													           Text="Sort by"
													          Classes="lbl compact-text" />
													<StackPanel Grid.Row="0"
													            Grid.Column="1">
														<ComboBox ItemsSource="{Binding SortOptions}"
														          SelectedIndex="{Binding SortByIndex, Mode=TwoWay}"
														          HorizontalAlignment="Stretch" Classes="compact-control" />
														<TextBlock Classes="hint compact-text"
														           Text="Modified lists the most recently changed assets first" />
													</StackPanel>

													<TextBlock Grid.Row="1"
													           Text="Folders first"
													          Classes="lbl compact-text" />
													<StackPanel Grid.Row="1"
													            Grid.Column="1">
														<elements:BoolBox Value="{Binding FoldersFirst, Mode=TwoWay}" Classes="compact-field" />
														<TextBlock Classes="hint compact-text"
														           Text="When off, folders are listed after the assets" />
													</StackPanel>

													<TextBlock Grid.Row="2"
													           Text="Search in"
													          Classes="lbl compact-text" />
													<StackPanel Grid.Row="2"
													            Grid.Column="1">
														<ComboBox ItemsSource="{Binding SearchScopes}"
														          SelectedIndex="{Binding SearchScopeIndex, Mode=TwoWay}"
														          HorizontalAlignment="Stretch" Classes="compact-control" />
														<TextBlock Classes="hint compact-text"
														           Text="Current folder searches the selected folder and everything under it" />
													</StackPanel>

													<TextBlock Grid.Row="3"
													           Text="Confirm delete"
													          Classes="lbl compact-text" />
													<StackPanel Grid.Row="3"
													            Grid.Column="1">
														<elements:BoolBox Value="{Binding ConfirmDelete, Mode=TwoWay}" Classes="compact-field" />
														<TextBlock Classes="hint compact-text"
														           Text="Ask before deleting assets and folders" />
													</StackPanel>

													<TextBlock Grid.Row="4"
													           Text="Hidden patterns"
													          Classes="lbl compact-text" />
													<StackPanel Grid.Row="4"
													            Grid.Column="1">
														<elements:StringBox Value="{Binding HiddenPatterns, Mode=TwoWay}"
														                    Wrap="False" Classes="compact-field" />
														<TextBlock Classes="hint compact-text"
														           Text="Comma separated, * and ? wildcards, matched against file and folder names. e.g. *.bak, _wip*" />
													</StackPanel>
												</Grid>
											</StackPanel>
										</Border>
									</StackPanel>
								</DataTemplate>
							</ContentControl.ContentTemplate>
						</ContentControl>
					</ScrollViewer>
				</Panel>
			</DockPanel>
		</Border>
	</Grid>
</UserControl>
