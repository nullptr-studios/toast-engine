<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:editor.Workspace"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="800"
             x:Class="editor.Workspace.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel"
             Background="{StaticResource Bg2}"
             Padding="8">
	<UserControl.Styles>
		<!-- Toolbar toggle -->
		<Style Selector="ToggleButton.tool">
			<Setter Property="Background"
			        Value="{StaticResource Bg3}" />
			<Setter Property="Foreground"
			        Value="{StaticResource Text}" />
			<Setter Property="BorderThickness"
			        Value="0" />
		</Style>
		<Style Selector="ToggleButton.tool /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Bg3}" />
		</Style>
		<Style Selector="ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Bg4}" />
		</Style>
		<Style Selector="ToggleButton.tool:checked">
			<Setter Property="Foreground"
			        Value="{StaticResource Bg1}" />
		</Style>
		<Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Foreground"
			        Value="{StaticResource Bg1}" />
		</Style>
		<Style Selector="ToggleButton.tool.red:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Red}" />
		</Style>
		<Style Selector="ToggleButton.tool.green:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Green}" />
		</Style>
		<Style Selector="ToggleButton.tool.blue:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Blue}" />
		</Style>
		<Style Selector="ToggleButton.tool.orange:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Orange}" />
		</Style>
		<Style Selector="ToggleButton.tool.purple:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Magenta}" />
		</Style>

		<Style Selector="ToggleButton.tool.camMode:not(:checked) /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Bg4}" />
		</Style>
		<Style Selector="ToggleButton.tool.camMode:not(:checked):pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Bg5}" />
		</Style>

		<!-- Snap value -->
		<Style Selector="Button.chev">
			<Setter Property="Background"
			        Value="{StaticResource Bg3}" />
			<Setter Property="Foreground"
			        Value="{StaticResource Text}" />
			<Setter Property="BorderThickness"
			        Value="0" />
		</Style>

		<Style Selector="ToggleButton.snapTool">
			<Setter Property="Background"
			        Value="{StaticResource Bg3}" />
			<Setter Property="Foreground"
			        Value="{StaticResource Text}" />
			<Setter Property="BorderThickness"
			        Value="0" />
		</Style>
		<Style Selector="ToggleButton.snapTool /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Bg3}" />
		</Style>
		<Style Selector="ToggleButton.snapTool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Bg4}" />
		</Style>
		<Style Selector="ToggleButton.snapTool:not(:checked) LucideIcon">
			<Setter Property="Foreground"
			        Value="{StaticResource TextMuted}" />
		</Style>
		<Style Selector="ToggleButton.snapTool:not(:checked) TextBlock.snapValue">
			<Setter Property="Foreground"
			        Value="{StaticResource TextMuted}" />
		</Style>

		<!-- Snap value text: fixed-width monospace so the toggle doesn't resize between "OFF" and a value -->
		<Style Selector="TextBlock.snapValue">
			<Setter Property="FontFamily"
			        Value="FiraCode Nerd Font,Consolas,monospace" />
			<Setter Property="Width"
			        Value="27" />
			<Setter Property="TextAlignment"
			        Value="Center" />
		</Style>
	</UserControl.Styles>

	<DockPanel VerticalSpacing="8">
		<Grid DockPanel.Dock="Top"
		      ColumnDefinitions="Auto,0,Auto,Auto,0,Auto,*,Auto,Auto"
		      ColumnSpacing="4">
			<StackPanel Grid.Column="0"
			            Orientation="Horizontal">
				<ToggleButton Classes="tool purple"
				              CornerRadius="6, 0, 0, 6"
				              ToolTip.Tip="Select (Q)"
				              Command="{Binding SetToolCommand}"
				              CommandParameter="Select"
				              IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Select, Mode=OneWay}">
					<LucideIcon Kind="MousePointer2"
					            Size="18"
					            StrokeWidth="2.5" />
				</ToggleButton>
				<ToggleButton Classes="tool red"
				              CornerRadius="0"
				              ToolTip.Tip="Move (E)"
				              Command="{Binding SetToolCommand}"
				              CommandParameter="Translate"
				              IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Translate, Mode=OneWay}">
					<LucideIcon Kind="Move3d"
					            Size="18"
					            StrokeWidth="2.5" />
				</ToggleButton>
				<ToggleButton Classes="tool green"
				              CornerRadius="0"
				              ToolTip.Tip="Rotate (R)"
				              Command="{Binding SetToolCommand}"
				              CommandParameter="Rotate"
				              IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Rotate, Mode=OneWay}">
					<LucideIcon Kind="Rotate3d"
					            Size="18"
					            StrokeWidth="2.5" />
				</ToggleButton>
				<ToggleButton Classes="tool blue"
				              CornerRadius="0"
				              ToolTip.Tip="Scale (T)"
				              Command="{Binding SetToolCommand}"
				              CommandParameter="Scale"
				              IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Scale, Mode=OneWay}">
					<LucideIcon Kind="Scale3d"
					            Size="18"
					            StrokeWidth="2.5" />
				</ToggleButton>
				<ToggleButton Classes="tool orange"
				              CornerRadius="0, 6, 6, 0"
				              ToolTip.Tip="Ruler (Y)"
				              Command="{Binding SetToolCommand}"
				              CommandParameter="Ruler"
				              IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Ruler, Mode=OneWay}">
					<LucideIcon Kind="Ruler"
					            Size="18"
					            StrokeWidth="2.5" />
				</ToggleButton>
			</StackPanel>

			<StackPanel Grid.Column="2"
			            Orientation="Horizontal">
				<ToggleButton Classes="tool blue"
				              CornerRadius="6, 0, 0, 6"
				              ToolTip.Tip="World coordinates (F)"
				              Command="{Binding SetSpaceCommand}"
				              CommandParameter="World"
				              IsChecked="{Binding WorldSpace, Mode=OneWay}">
					<LucideIcon Kind="Globe"
					            Size="18"
					            StrokeWidth="2.5" />
				</ToggleButton>
				<ToggleButton Classes="tool red"
				              CornerRadius="0, 6, 6, 0"
				              ToolTip.Tip="Local coordinates (F)"
				              Command="{Binding SetSpaceCommand}"
				              CommandParameter="Local"
				              IsChecked="{Binding !WorldSpace, Mode=OneWay}">
					<LucideIcon Kind="Box"
					            Size="18"
					            StrokeWidth="2.5" />
				</ToggleButton>
			</StackPanel>

			<StackPanel Grid.Column="3"
			            Orientation="Horizontal">
				<ToggleButton Classes="snapTool red"
				              CornerRadius="6, 0, 0, 6"
				              ToolTip.Tip="Grid snapping (G)"
				              IsChecked="{Binding TranslateSnapEnabled}">
					<StackPanel Orientation="Horizontal"
					            Spacing="8"
					            VerticalAlignment="Center">
						<LucideIcon Kind="Grid2x2"
						            Size="18"
						            StrokeWidth="2.5" />
						<TextBlock Classes="snapValue"
						           Text="Off"
						           VerticalAlignment="Center"
						           IsVisible="{Binding !TranslateSnapEnabled}" />
						<TextBlock Classes="snapValue"
						           Text="{Binding TranslateSnap, Converter={StaticResource SnapValueConverter}}"
						           IsVisible="{Binding TranslateSnapEnabled}"
						           VerticalAlignment="Center"
						           HorizontalAlignment="Right" />
					</StackPanel>
				</ToggleButton>
				<ToggleButton Classes="snapTool green"
				              CornerRadius="0"
				              ToolTip.Tip="Rotate snapping (Shift+G)"
				              IsChecked="{Binding RotateSnapEnabled}">
					<StackPanel Orientation="Horizontal"
					            VerticalAlignment="Center"
					            Spacing="8">
						<LucideIcon Kind="RotateCw"
						            Size="18"
						            StrokeWidth="2.5" />
						<TextBlock Classes="snapValue"
						           Text="Off"
						           VerticalAlignment="Center"
						           IsVisible="{Binding !RotateSnapEnabled}" />
						<TextBlock Classes="snapValue"
						           Text="{Binding RotateSnap, Converter={StaticResource SnapValueConverter}, ConverterParameter=int}"
						           IsVisible="{Binding RotateSnapEnabled}"
						           VerticalAlignment="Center"
						           HorizontalAlignment="Right" />
					</StackPanel>
				</ToggleButton>
				<ToggleButton Classes="snapTool blue"
				              CornerRadius="0"
				              ToolTip.Tip="Scale snapping (Alt+G)"
				              IsChecked="{Binding ScaleSnapEnabled}">
					<StackPanel Orientation="Horizontal"
					            VerticalAlignment="Center"
					            Spacing="8">
						<LucideIcon Kind="Maximize2"
						            Size="18"
						            StrokeWidth="2.5" />
						<TextBlock Classes="snapValue"
						           Text="Off"
						           VerticalAlignment="Center"
						           IsVisible="{Binding !ScaleSnapEnabled}" />
						<TextBlock Classes="snapValue"
						           Text="{Binding ScaleSnap, Converter={StaticResource SnapValueConverter}}"
						           IsVisible="{Binding ScaleSnapEnabled}"
						           VerticalAlignment="Center"
						           HorizontalAlignment="Right" />
					</StackPanel>
				</ToggleButton>
				<Button Classes="chev"
				        CornerRadius="0, 6, 6, 0"
				        ToolTip.Tip="Snap values">
					<Button.Flyout>
						<Flyout Placement="Bottom">
							<StackPanel Spacing="8"
							            MinWidth="120">
								<Grid ColumnDefinitions="Auto,*,Auto,Auto"
								      ColumnSpacing="8">
									<LucideIcon Grid.Column="0"
									            Kind="Grid2x2"
									            Size="16"
									            StrokeWidth="2.5"
									            VerticalAlignment="Center" />
									<TextBlock Grid.Column="1"
									           Classes="snapValue"
									           Text="{Binding TranslateSnap, Converter={StaticResource SnapValueConverter}}"
									           VerticalAlignment="Center"
									           HorizontalAlignment="Right" />
									<Button Grid.Column="2"
									        Classes="chev"
									        Width="24"
									        Height="24"
									        Padding="0"
									        Command="{Binding StepTranslateSnapCommand}"
									        CommandParameter="-1">
										<LucideIcon Kind="Minus"
										            Size="14"
										            StrokeWidth="2.5" />
									</Button>
									<Button Grid.Column="3"
									        Classes="chev"
									        Width="24"
									        Height="24"
									        Padding="0"
									        Command="{Binding StepTranslateSnapCommand}"
									        CommandParameter="1">
										<LucideIcon Kind="Plus"
										            Size="14"
										            StrokeWidth="2.5" />
									</Button>
								</Grid>
								<Grid ColumnDefinitions="Auto,*,Auto,Auto"
								      ColumnSpacing="8">
									<LucideIcon Grid.Column="0"
									            Kind="RotateCw"
									            Size="16"
									            StrokeWidth="2.5"
									            VerticalAlignment="Center" />
									<TextBlock Grid.Column="1"
									           Classes="snapValue"
									           Text="{Binding RotateSnap, Converter={StaticResource SnapValueConverter}, ConverterParameter=int}"
									           VerticalAlignment="Center"
									           HorizontalAlignment="Right" />
									<Button Grid.Column="2"
									        Classes="chev"
									        Width="24"
									        Height="24"
									        Padding="0"
									        Command="{Binding StepRotateSnapCommand}"
									        CommandParameter="-1">
										<LucideIcon Kind="Minus"
										            Size="14"
										            StrokeWidth="2.5" />
									</Button>
									<Button Grid.Column="3"
									        Classes="chev"
									        Width="24"
									        Height="24"
									        Padding="0"
									        Command="{Binding StepRotateSnapCommand}"
									        CommandParameter="1">
										<LucideIcon Kind="Plus"
										            Size="14"
										            StrokeWidth="2.5" />
									</Button>
								</Grid>
								<Grid ColumnDefinitions="Auto,*,Auto,Auto"
								      ColumnSpacing="8">
									<LucideIcon Grid.Column="0"
									            Kind="Maximize2"
									            Size="16"
									            StrokeWidth="2.5"
									            VerticalAlignment="Center" />
									<TextBlock Grid.Column="1"
									           Classes="snapValue"
									           Text="{Binding ScaleSnap, Converter={StaticResource SnapValueConverter}}"
									           VerticalAlignment="Center"
									           HorizontalAlignment="Right" />
									<Button Grid.Column="2"
									        Classes="chev"
									        Width="24"
									        Height="24"
									        Padding="0"
									        Command="{Binding StepScaleSnapCommand}"
									        CommandParameter="-1">
										<LucideIcon Kind="Minus"
										            Size="14"
										            StrokeWidth="2.5" />
									</Button>
									<Button Grid.Column="3"
									        Classes="chev"
									        Width="24"
									        Height="24"
									        Padding="0"
									        Command="{Binding StepScaleSnapCommand}"
									        CommandParameter="1">
										<LucideIcon Kind="Plus"
										            Size="14"
										            StrokeWidth="2.5" />
									</Button>
								</Grid>
							</StackPanel>
						</Flyout>
					</Button.Flyout>
					<LucideIcon Kind="ChevronDown"
					            Size="18"
					            StrokeWidth="2.5" />
				</Button>
			</StackPanel>

			<StackPanel Grid.Column="5"
			            Orientation="Horizontal">
				<Button Background="{StaticResource Bg3}"
				        CornerRadius="6, 0, 0, 6"
				        ToolTip.Tip="Change viewport mode">
					<Button.Flyout>
						<MenuFlyout>
							<MenuItem Header="Lit"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="Lit" />
							<MenuItem Header="Cluster Heatmap"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="ClusterHeatmap"
							          ToolTip.Tip="Forward+ debug view: per-pixel clustered light count (blue=0, red=8+)" />
							<Separator />
							<MenuItem Header="Albedo"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="Albedo"
							          ToolTip.Tip="Base colour as sampled, before any lighting" />
							<MenuItem Header="Normal"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="Normal"
							          ToolTip.Tip="World-space shading normal, remapped to 0..1" />
							<MenuItem Header="Metallic / Roughness"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="MetallicRoughness"
							          ToolTip.Tip="Red is metallic, green is roughness" />
							<MenuItem Header="Ambient"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="Ambient"
							          ToolTip.Tip="Ambient radiance reaching the surface, before albedo" />
							<MenuItem Header="Specular IBL"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="SpecularIbl"
							          ToolTip.Tip="Prefiltered environment along the reflection vector - the only thing lighting a metal in an unlit scene" />
							<MenuItem Header="Specular IBL (mip 0)"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="SpecularIblMip0"
							          ToolTip.Tip="Same lookup pinned to the sharpest mip - isolates whether the coarse mips are the problem" />
							<MenuItem Header="Reflection Vector"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="Reflection"
							          ToolTip.Tip="Reflection direction remapped to 0..1 - shows which patch of the cubemap a surface samples" />
							<MenuItem Header="Reflection Probes"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="ReflectionProbes"
							          ToolTip.Tip="Which probe owns each surface (hue) and how strongly (brightness); grey means the global environment" />
							<MenuItem Header="Probe Capture"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="ProbeCapture"
							          ToolTip.Tip="What the owning probe captured; magenta = no probe, yellow = unbaked, black = the capture itself is black" />
							<MenuItem Header="Probe Cubemap"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="ProbeCubemap"
							          ToolTip.Tip="The probe's cubemap along the view ray - look around inside the capture; roughness picks the mip" />
							<Separator />
							<MenuItem Header="Normal Buffer"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="NormalBuffer"
							          ToolTip.Tip="The G-buffer's world normals, read back out of the buffer SSR traces against; black means nothing wrote there" />
							<MenuItem Header="Roughness Buffer"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="RoughnessBuffer"
							          ToolTip.Tip="The other half of the G-buffer - what SSR uses to decide how much a surface reflects" />
							<MenuItem Header="SSR Only"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="SsrOnly"
							          ToolTip.Tip="The traced reflection before it is weighted into the scene - separates a failed march from a discarded one" />
							<MenuItem Header="Ambient Occlusion"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="AmbientOcclusion"
							          ToolTip.Tip="The AO factor on its own - white is unoccluded, so a fully white image means the radius is too small for the scene's scale" />
							<MenuItem Header="Irradiance Volumes"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="IrradianceVolumes"
							          ToolTip.Tip="Interpolated volume irradiance; magenta = no volume covers this point, yellow = covered but never baked" />
							<Separator />
							<MenuItem Header="Traced Shadows (visibility)"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="TracedShadowsOnly"
							          ToolTip.Tip="Ray-traced directional visibility on its own - white lit, black occluded. Needs ray query support" />
							<MenuItem Header="Traced Shadows (applied)"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="TracedShadows"
							          ToolTip.Tip="The lit scene multiplied by traced visibility, for comparing against the shadow-map result" />
							<MenuItem Header="Shadow Term"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="ShadowTerm"
							          ToolTip.Tip="The shadow factor every light resolved to, strongest occlusion wins - white lit, black fully shadowed. Toggle 'Traced shadows (all lights)' in the Toast Debug panel to swap a ray-traced reference under the same camera; wherever the two disagree is the shadow map's error" />
							<Separator />
							<MenuItem Header="Voxel DDA Steps"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="VoxelSteps"
							          ToolTip.Tip="March cost per pixel in power-of-two bands, blue 1-3 steps up to magenta 256+, white where a ray hit the step cap. Hatched pixels are box pixels whose ray missed but still marched. Meshes go grey; the legend and the voxel under the cursor show bottom left" />
							<MenuItem Header="Voxel Traversal Levels"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="VoxelTraversal"
							          ToolTip.Tip="Where each ray spent its steps - blue skipping empty 32-voxel coarse cells, green skipping empty bricks, red stepping voxel by voxel. Red far from any surface means empty-space skipping is not engaging" />
							<MenuItem Header="Voxel Brick Storage"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="VoxelBricks"
							          ToolTip.Tip="Each brick's storage - blue uniform (no pool memory), green shared with the asset, orange owned by this instance after a write. Dark lines are brick edges, white coarse cells. Watch damaged bricks turn orange" />
							<MenuItem Header="Voxel Volumes"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="VoxelVolumes"
							          ToolTip.Tip="One hue per volume, with the box footprint hatched where the ray missed - the rasterized area paid for but empty" />
							<MenuItem Header="Voxel Materials"
							          Command="{Binding SetRenderModeCommand}"
							          CommandParameter="VoxelMaterials"
							          ToolTip.Tip="One hue per physical material id. Magenta stripes are material 0, the default that every palette entry authored without a material silently falls back to" />
						</MenuFlyout>
					</Button.Flyout>
					<StackPanel Orientation="Horizontal"
					            Spacing="8">
						<LucideIcon Kind="Eclipse"
						            Size="18"
						            StrokeWidth="2.5" />
						<TextBlock Text="{Binding ActiveRenderMode}" />
					</StackPanel>
				</Button>
				<Button Background="{StaticResource Bg3}"
				        CornerRadius="0, 6, 6, 0"
				        ToolTip.Tip="Toggle render passes visibility"
				        Command="{Binding RefreshRenderPassesCommand}">
					<Button.Flyout>
						<Flyout Placement="Bottom">
							<StackPanel MinWidth="180"
							            Spacing="4">
								<TextBlock Text="Render Passes"
								           FontWeight="Bold"
								           Margin="0,0,0,4" />
								<ItemsControl ItemsSource="{Binding RenderPasses}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:RenderPassVM">
											<CheckBox Content="{Binding Name}"
											          IsChecked="{Binding Enabled, Mode=TwoWay}" />
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<TextBlock Text="No passes reported"
								           FontStyle="Italic"
								           Foreground="{StaticResource TextMuted}"
								           IsVisible="{Binding !RenderPasses.Count}" />
							</StackPanel>
						</Flyout>
					</Button.Flyout>
					<LucideIcon Kind="Eye"
					            Size="18"
					            StrokeWidth="2.5" />
				</Button>
			</StackPanel>

			<StackPanel Grid.Column="8"
			            Orientation="Horizontal">
				<ToggleButton Classes="tool red"
				              CornerRadius="6, 0, 0, 6"
				              ToolTip.Tip="Switch between editor and game camera"
				              IsChecked="{Binding GameCamera}">
					<StackPanel Orientation="Horizontal"
					            Spacing="8">
						<LucideIcon Kind="Video"
						            Size="18"
						            StrokeWidth="2.5" />
						<TextBlock Text="Editor"
						           IsVisible="{Binding !GameCamera}" />
						<TextBlock Text="Game"
						           IsVisible="{Binding GameCamera}" />
					</StackPanel>
				</ToggleButton>
				<Button CornerRadius="0, 6, 6, 0"
				        Background="{StaticResource Bg3}"
				        ToolTip.Tip="Camera settings"
				        IsEnabled="{Binding !GameCamera}">
					<Button.Flyout>
						<Flyout Placement="BottomEdgeAlignedRight">
							<StackPanel Spacing="8"
							            MinWidth="180">
								<Grid ColumnDefinitions="*,*">
									<ToggleButton Grid.Column="0"
									              Classes="tool red camMode"
									              CornerRadius="6, 0, 0, 6"
									              HorizontalAlignment="Stretch"
									              HorizontalContentAlignment="Left"
									              ToolTip.Tip="Fly camera: hold RMB to look, WASD to move"
									              Command="{Binding SetEditorCameraModeCommand}"
									              CommandParameter="Free"
									              IsChecked="{Binding CameraMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Free, Mode=OneWay}">
										<StackPanel Orientation="Horizontal"
										            Spacing="8">
											<LucideIcon Kind="Camera"
											            Size="16"
											            StrokeWidth="2.5" />
											<TextBlock Text="Free" />
										</StackPanel>
									</ToggleButton>
									<ToggleButton Grid.Column="1"
									              Classes="tool red camMode"
									              CornerRadius="0, 6, 6, 0"
									              HorizontalAlignment="Stretch"
									              HorizontalContentAlignment="Left"
									              ToolTip.Tip="Orbit the world origin: two-finger drag to swing, pinch to zoom"
									              Command="{Binding SetEditorCameraModeCommand}"
									              CommandParameter="Orbit"
									              IsChecked="{Binding CameraMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Orbit, Mode=OneWay}">
										<StackPanel Orientation="Horizontal"
										            Spacing="8">
											<LucideIcon Kind="Rotate3d"
											            Size="16"
											            StrokeWidth="2.5" />
											<TextBlock Text="Orbit" />
										</StackPanel>
									</ToggleButton>
								</Grid>
								<Grid ColumnDefinitions="Auto,*,Auto,Auto"
								      ColumnSpacing="8">
									<LucideIcon Grid.Column="0"
									            Kind="Gauge"
									            Size="16"
									            StrokeWidth="2.5"
									            VerticalAlignment="Center" />
									<TextBlock Grid.Column="1"
									           Classes="snapValue"
									           Text="{Binding CameraSpeed, Converter={StaticResource SnapValueConverter}}"
									           VerticalAlignment="Center"
									           HorizontalAlignment="Right" />
									<Button Grid.Column="2"
									        Classes="chev"
									        Width="24"
									        Height="24"
									        Padding="0"
									        Command="{Binding StepCameraSpeedCommand}"
									        CommandParameter="-1">
										<LucideIcon Kind="Minus"
										            Size="14"
										            StrokeWidth="2.5" />
									</Button>
									<Button Grid.Column="3"
									        Classes="chev"
									        Width="24"
									        Height="24"
									        Padding="0"
									        Command="{Binding StepCameraSpeedCommand}"
									        CommandParameter="1">
										<LucideIcon Kind="Plus"
										            Size="14"
										            StrokeWidth="2.5" />
									</Button>
								</Grid>
							</StackPanel>
						</Flyout>
					</Button.Flyout>
					<LucideIcon Kind="ChevronDown"
					            Size="18"
					            StrokeWidth="2.5" />
				</Button>
			</StackPanel>

			<StackPanel Grid.Column="7"
			            Orientation="Horizontal">
				<ToggleButton Classes="tool red"
				              CornerRadius="6, 0, 0, 6"
				              ToolTip.Tip="Play (F5)"
				              Command="{Binding TogglePlayCommand}"
				              IsChecked="{Binding IsPlaying, Mode=OneWay}">
					<Panel>
						<LucideIcon Kind="Play"
						            Size="18"
						            StrokeWidth="2.5"
						            IsVisible="{Binding !IsPlaying}" />
						<LucideIcon Kind="Square"
						            Size="18"
						            StrokeWidth="2.5"
						            IsVisible="{Binding IsPlaying}" />
					</Panel>
				</ToggleButton>
				<ToggleButton Classes="tool red"
				              CornerRadius="0"
				              ToolTip.Tip="Simulate (Shift+F5)"
				              Command="{Binding ToggleSimulateCommand}"
				              IsChecked="{Binding IsSimulating, Mode=OneWay}">
					<Panel>
						<LucideIcon Kind="BugPlay"
						            Size="18"
						            StrokeWidth="2.5"
						            IsVisible="{Binding !IsSimulating}" />
						<LucideIcon Kind="Square"
						            Size="18"
						            StrokeWidth="2.5"
						            IsVisible="{Binding IsSimulating}" />
					</Panel>
				</ToggleButton>
				<ToggleButton Classes="tool orange"
				              CornerRadius="0"
				              ToolTip.Tip="Pause"
				              IsEnabled="{Binding CanPause}"
				              IsChecked="{Binding IsPaused}">
					<LucideIcon Kind="Pause"
					            Size="18"
					            StrokeWidth="2.5" />
				</ToggleButton>
				<ToggleButton Classes="tool red"
				              CornerRadius="0, 6, 6, 0"
				              ToolTip.Tip="Play on external window (F6)"
				              Command="{Binding TogglePlayExternalCommand}"
				              IsChecked="{Binding IsPlayingExternal, Mode=OneWay}">
					<Panel>
						<LucideIcon Kind="MonitorPlay"
						            Size="18"
						            StrokeWidth="2.5"
						            IsVisible="{Binding !IsPlayingExternal}" />
						<LucideIcon Kind="MonitorStop"
						            Size="18"
						            StrokeWidth="2.5"
						            IsVisible="{Binding IsPlayingExternal}" />
					</Panel>
				</ToggleButton>
			</StackPanel>
		</Grid>
		<Panel x:Name="ViewportPanel">
			<vm:ViewportControl x:Name="Viewport"
			                    PlayMode="{Binding IsPlayingInViewport}"
			                    IsVisible="{Binding !IsPlayingExternal}" />
			<!-- while playing on the external window the tab viewport is blacked out -->
			<Border CornerRadius="8"
			        Background="{StaticResource Bg1}"
			        IsVisible="{Binding IsPlayingExternal}">
				<TextBlock Text="Node opened in another window"
				           Foreground="{StaticResource TextMuted}"
				           FontStyle="Italic"
				           HorizontalAlignment="Center"
				           VerticalAlignment="Center" />
			</Border>
		</Panel>
	</DockPanel>
</UserControl>
