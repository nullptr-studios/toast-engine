<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:editor.Workspace"
        x:Class="editor.Workspace.HistoryConflictWindow"
        x:DataType="vm:HistoryConflictDialogViewModel"
        Title="Resolve history conflicts"
        Width="940"
        Height="600"
        MinWidth="700"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg2}">
	<Grid RowDefinitions="Auto,*,Auto"
	      Margin="16"
	      RowSpacing="12">
		<StackPanel>
			<TextBlock Text="{Binding Title}"
			           FontSize="20"
			           FontWeight="SemiBold" />
			<TextBlock Text="Choose the result for every conflict. Nothing is applied until Resolve is pressed."
			           Foreground="{StaticResource TextMuted}" />
		</StackPanel>

		<ScrollViewer Grid.Row="1">
			<ItemsControl ItemsSource="{Binding Conflicts}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:HistoryConflictItemViewModel">
						<Border Margin="0,0,0,8"
						        Padding="12"
						        CornerRadius="8"
						        Background="{StaticResource Bg3}">
							<Grid RowDefinitions="Auto,Auto,Auto"
							      ColumnDefinitions="160,*,*,*"
							      ColumnSpacing="8"
							      RowSpacing="8">
								<StackPanel Grid.ColumnSpan="4"
								            Orientation="Horizontal"
								            Spacing="8">
									<LucideIcon Kind="GitMergeConflict"
									            Foreground="{StaticResource Red}"
									            Size="18" />
									<TextBlock Text="{Binding DisplayName}"
									           FontWeight="SemiBold" />
								</StackPanel>
								<TextBlock Grid.Row="1"
								           Text="Base"
								           Foreground="{StaticResource TextMuted}" />
								<TextBlock Grid.Row="1"
								           Grid.Column="1"
								           Text="Current"
								           Foreground="{StaticResource TextMuted}" />
								<TextBlock Grid.Row="1"
								           Grid.Column="2"
								           Text="Incoming"
								           Foreground="{StaticResource TextMuted}" />
								<TextBlock Grid.Row="1"
								           Grid.Column="3"
								           Text="Resolution"
								           Foreground="{StaticResource TextMuted}" />
								<TextBlock Grid.Row="2"
								           Text="{Binding BaseValue}"
								           TextWrapping="Wrap" />
								<TextBlock Grid.Row="2"
								           Grid.Column="1"
								           Text="{Binding CurrentValue}"
								           TextWrapping="Wrap" />
								<TextBlock Grid.Row="2"
								           Grid.Column="2"
								           Text="{Binding IncomingValue}"
								           TextWrapping="Wrap" />
								<StackPanel Grid.Row="2"
								            Grid.Column="3"
								            Spacing="6">
									<ComboBox ItemsSource="{Binding Choices}"
									          SelectedItem="{Binding Choice}" />
									<TextBlock Text="{Binding CustomType}"
									           Foreground="{StaticResource TextMuted}"
									           IsVisible="{Binding ShowCustom}" />
									<CheckBox Content="Use true"
									          IsChecked="{Binding CustomBool}"
									          IsVisible="{Binding IsBooleanCustom}" />
									<NumericUpDown Value="{Binding CustomNumber}"
									               IsVisible="{Binding IsNumberCustom}" />
									<TextBox Text="{Binding CustomValue}"
									         PlaceholderText="Custom value"
									         IsVisible="{Binding IsTextCustom}" />
								</StackPanel>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<StackPanel Grid.Row="2"
		            Orientation="Horizontal"
		            HorizontalAlignment="Right"
		            Spacing="8">
			<Button Content="Cancel"
			        Click="OnCancel" />
			<Button Background="{StaticResource Red}"
			        Foreground="{StaticResource Text}"
			        Click="OnResolve">
				<StackPanel Orientation="Horizontal"
				            Spacing="6">
					<LucideIcon Kind="GitMerge"
					            Size="17" />
					<TextBlock Text="Resolve" />
				</StackPanel>
			</Button>
		</StackPanel>
	</Grid>
</Window>