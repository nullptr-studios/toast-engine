<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:editor.Workspace"
             xmlns:conv="using:editor.Components.Converters"
             mc:Ignorable="d"
             x:Class="editor.Workspace.HistoryView"
             x:DataType="vm:HistoryViewModel"
             d:DesignWidth="720"
             d:DesignHeight="800">
	<UserControl.Resources>
		<conv:ResourceBrushConverter x:Key="BrushFromKey" />
	</UserControl.Resources>

	<Border Background="{StaticResource Bg2}"
	        Padding="8">
		<Grid RowDefinitions="Auto,*"
		      RowSpacing="8">
			<Border Padding="8"
			        CornerRadius="8"
			        Background="{StaticResource Bg3}">
				<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
				      ColumnSpacing="4">
					<Button Grid.Column="0"
					        Command="{Binding UndoCommand}"
					        ToolTip.Tip="Undo (Ctrl+Z)"
					        CornerRadius="6"
					        Background="{StaticResource Bg4}">
						<LucideIcon Kind="Undo2"
						            Size="18"
						            StrokeWidth="2.5" />
					</Button>
					<Button Grid.Column="1"
					        Command="{Binding RedoCommand}"
					        ToolTip.Tip="Redo (Ctrl+Shift+Z)"
					        CornerRadius="6"
					        Background="{StaticResource Bg4}">
						<LucideIcon Kind="Redo2"
						            Size="18"
						            StrokeWidth="2.5" />
					</Button>
					<Button Grid.Column="3"
					        Command="{Binding CheckoutCommand}"
					        ToolTip.Tip="Switch to selected revision"
					        CornerRadius="6"
					        Background="{StaticResource Bg4}">
						<LucideIcon Kind="GitBranch"
						            Size="18"
						            StrokeWidth="2.5" />
					</Button>
					<Button Grid.Column="4"
					        Command="{Binding CherryPickCommand}"
					        ToolTip.Tip="Cherry-pick selected revision"
					        CornerRadius="6"
					        Background="{StaticResource Bg4}">
						<LucideIcon Kind="GitCommitHorizontal"
						            Size="18"
						            StrokeWidth="2.5" />
					</Button>
					<Button Grid.Column="5"
					        Command="{Binding MergeCommand}"
					        ToolTip.Tip="Merge selected revision"
					        CornerRadius="6"
					        Background="{StaticResource Bg4}">
						<LucideIcon Kind="GitMerge"
						            Size="18"
						            StrokeWidth="2.5" />
					</Button>
				</Grid>
			</Border>

			<Grid Grid.Row="1">
				<StackPanel HorizontalAlignment="Center"
				            VerticalAlignment="Center"
				            Spacing="8"
				            IsVisible="{Binding !Available}">
					<LucideIcon Kind="History"
					            Size="42"
					            Foreground="{StaticResource TextMuted}"
					            HorizontalAlignment="Center" />
					<TextBlock Text="{Binding UnavailableReason}"
					           Foreground="{StaticResource TextMuted}"
					           TextAlignment="Center"
					           TextWrapping="Wrap" />
				</StackPanel>

				<Grid IsVisible="{Binding Available}"
				      RowDefinitions="Auto,*"
				      Background="{StaticResource Bg2}">
					<Grid ColumnDefinitions="Auto,1.05*,26,1.35*,1.1*,1.1*"
					      Height="28"
					      ColumnSpacing="4">
						<TextBlock Grid.Column="1"
						           Text="Node"
						           Foreground="{StaticResource TextMuted}" />
						<TextBlock Grid.Column="3"
						           Text="Operation"
						           Foreground="{StaticResource TextMuted}" />
						<TextBlock Grid.Column="4"
						           Text="Previous"
						           Foreground="{StaticResource TextMuted}" />
						<TextBlock Grid.Column="5"
						           Text="Current"
						           Foreground="{StaticResource TextMuted}" />
					</Grid>
					<ListBox Grid.Row="1"
					         ItemsSource="{Binding Rows}"
					         SelectedItem="{Binding SelectedRevision}"
					         HorizontalAlignment="Stretch"
					         Background="{StaticResource Bg2}">
						<ListBox.Styles>
							<Style Selector="ListBoxItem">
								<Setter Property="Padding"
								        Value="0" />
								<Setter Property="MinHeight"
								        Value="34" />
								<Setter Property="Background"
								        Value="Transparent" />
							</Style>
							<Style Selector="ListBoxItem:selected">
								<Setter Property="Background"
								        Value="{StaticResource Bg3}" />
								<Setter Property="CornerRadius"
								        Value="8" />
							</Style>
							<Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
								<Setter Property="Background"
								        Value="{StaticResource Bg3}" />
								<Setter Property="CornerRadius"
								        Value="8" />
							</Style>
							<Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
								<Setter Property="Background"
								        Value="{StaticResource Bg3}" />
							</Style>
							<Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
								<Setter Property="Background"
								        Value="{StaticResource Bg3}" />
							</Style>
						</ListBox.Styles>
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="vm:HistoryRowViewModel">
								<Grid ColumnDefinitions="Auto,1.05*,26,1.35*,1.1*,1.1*"
								      Height="34"
								      ColumnSpacing="4"
								      HorizontalAlignment="Stretch"
								      Background="Transparent"
								      PointerPressed="OnRowPointerPressed">
									<Grid.ContextMenu>
										<ContextMenu x:DataType="vm:HistoryRowViewModel">
											<MenuItem Header="Go to revision"
											          Command="{Binding Owner.CheckoutRevisionCommand}"
											          CommandParameter="{Binding}" />
											<Separator />
											<MenuItem Header="Cherry-pick revision"
											          Command="{Binding Owner.CherryPickRevisionCommand}"
											          CommandParameter="{Binding}" />
											<MenuItem Header="Merge revision"
											          Command="{Binding Owner.MergeRevisionCommand}"
											          CommandParameter="{Binding}" />
										</ContextMenu>
									</Grid.ContextMenu>
									<vm:HistoryGraphCell Row="{Binding}" />
									<TextBlock Grid.Column="1"
									           Text="{Binding NodeName}"
									           VerticalAlignment="Center"
									           Foreground="{Binding TextColorKey, Converter={StaticResource BrushFromKey}}"
									           TextTrimming="CharacterEllipsis"
									           ToolTip.Tip="{Binding NodeName}" />
									<LucideIcon Grid.Column="2"
									            Kind="{Binding Icon}"
									            Size="17"
									            VerticalAlignment="Center"
									            Foreground="{Binding AccentColorKey, Converter={StaticResource BrushFromKey}}" />
									<TextBlock Grid.Column="3"
									           Text="{Binding OperationText}"
									           VerticalAlignment="Center"
									           Foreground="{Binding TextColorKey, Converter={StaticResource BrushFromKey}}"
									           TextTrimming="CharacterEllipsis"
									           ToolTip.Tip="{Binding OperationText}" />
									<TextBlock Grid.Column="4"
									           Text="{Binding PreviousValue}"
									           VerticalAlignment="Center"
									           Foreground="{Binding TextColorKey, Converter={StaticResource BrushFromKey}}"
									           TextTrimming="CharacterEllipsis"
									           ToolTip.Tip="{Binding PreviousValue}" />
									<TextBlock Grid.Column="5"
									           Text="{Binding CurrentValue}"
									           VerticalAlignment="Center"
									           Foreground="{Binding TextColorKey, Converter={StaticResource BrushFromKey}}"
									           TextTrimming="CharacterEllipsis"
									           ToolTip.Tip="{Binding CurrentValue}" />
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Grid>
			</Grid>
		</Grid>
	</Border>
</UserControl>