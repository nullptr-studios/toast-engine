<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:git="using:editor.Git"
             xmlns:elements="using:editor.Components.Elements"
             mc:Ignorable="d"
             x:Class="editor.Git.CommitView"
             x:DataType="git:CommitViewModel"
             d:DesignWidth="1000"
             d:DesignHeight="650">
	<UserControl.Resources>
		<DataTemplate x:Key="FileRow"
		              x:DataType="git:GitFileRow">
			<Grid ColumnDefinitions="Auto,Auto,*,Auto"
			      ColumnSpacing="4"
			      Margin="2,3">
				<Border Grid.Column="0"
				        VerticalAlignment="Center"
				        Background="{Binding TypeBrush}"
				        CornerRadius="4"
				        Padding="6,2">
					<TextBlock Text="{Binding TypeLabel}"
					           FontSize="10"
					           FontWeight="Bold"
					           Foreground="{StaticResource Bg1}" />
				</Border>
				<TextBlock Grid.Column="1"
				           Text="{Binding Name}"
				           FontWeight="SemiBold"
				           VerticalAlignment="Center" />
				<TextBlock Grid.Column="2"
				           Text="{Binding RelPath}"
				           Foreground="{StaticResource TextMuted}"
				           FontSize="11"
				           TextTrimming="CharacterEllipsis"
				           VerticalAlignment="Center" />
				<elements:GitChip Grid.Column="3"
				                  Status="{Binding Status}"
				                  VerticalAlignment="Center" />
			</Grid>
		</DataTemplate>
	</UserControl.Resources>

	<UserControl.Styles>
		<!-- File rows -->
		<Style Selector="ListBoxItem">
			<Setter Property="CornerRadius"
			        Value="8" />
		</Style>
		<Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="CornerRadius"
			        Value="8" />
		</Style>
		<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Bg5}" />
		</Style>
		<Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Bg4}" />
		</Style>
		<Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Bg4}" />
		</Style>
		<Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background"
			        Value="{StaticResource Bg4}" />
		</Style>
	</UserControl.Styles>

	<Border Background="{StaticResource Bg2}"
	        Padding="8">
		<Grid ColumnDefinitions="3*,Auto,2*">
			<Grid Grid.Column="0">
				<Grid.RowDefinitions>
					<RowDefinition Height="*"
					               MinHeight="120" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*"
					               MinHeight="120" />
				</Grid.RowDefinitions>

				<Border Grid.Row="0"
				        Background="{StaticResource Bg3}"
				        CornerRadius="8"
				        Padding="8">
					<Grid RowDefinitions="Auto,*"
					      RowSpacing="6">
						<Grid ColumnDefinitions="*,Auto,Auto"
						      ColumnSpacing="4">
							<StackPanel Orientation="Horizontal"
							            Spacing="8"
							            VerticalAlignment="Center">
								<TextBlock Text="Changes"
								           FontWeight="Bold" />
								<TextBlock Text="{Binding Unstaged.Count}"
								           Foreground="{StaticResource TextMuted}" />
							</StackPanel>
							<Button Grid.Column="1"
							        Command="{Binding DiscardAllCommand}"
							        ToolTip.Tip="Throw away every change below"
							        Background="{StaticResource Bg4}"
							        CornerRadius="6">
								<StackPanel Orientation="Horizontal"
								            Spacing="6">
									<LucideIcon Kind="Trash2"
									            Size="14"
									            StrokeWidth="2.5"/>
									<TextBlock Text="Discard All" />
								</StackPanel>
							</Button>
							<Button Grid.Column="2"
							        Command="{Binding StageAllCommand}"
							        ToolTip.Tip="Stage every change"
							        Background="{StaticResource Bg4}"
							        CornerRadius="6">
								<StackPanel Orientation="Horizontal"
								            Spacing="6">
									<LucideIcon Kind="Plus"
									            Size="14"
									            StrokeWidth="2.5" />
									<TextBlock Text="Stage All" />
								</StackPanel>
							</Button>
						</Grid>
						<ListBox Grid.Row="1"
						         x:Name="UnstagedList"
						         ItemsSource="{Binding Unstaged}"
						         ItemTemplate="{StaticResource FileRow}"
						         SelectionMode="Multiple"
						         Background="Transparent"
						         DoubleTapped="OnUnstagedDoubleTapped"
						         KeyDown="OnUnstagedKeyDown">
							<ListBox.ContextMenu>
								<ContextMenu>
									<MenuItem Click="OnStageClick"
									          InputGesture="Enter">
										<MenuItem.Header>
											<StackPanel Orientation="Horizontal"
											            Spacing="8">
												<LucideIcon Kind="Plus"
												            StrokeWidth="2.5"
												            Size="16" />
												<TextBlock Text="Stage" />
											</StackPanel>
										</MenuItem.Header>
									</MenuItem>
									<Separator />
									<MenuItem Click="OnDiscardClick"
									          InputGesture="Delete">
										<MenuItem.Header>
											<StackPanel Orientation="Horizontal"
											            Spacing="8">
												<LucideIcon Kind="Trash2"
												            StrokeWidth="2.5"
												            Size="16"
												            Foreground="{StaticResource Red}" />
												<TextBlock Text="Discard" />
											</StackPanel>
										</MenuItem.Header>
									</MenuItem>
								</ContextMenu>
							</ListBox.ContextMenu>
						</ListBox>
					</Grid>
				</Border>

				<GridSplitter Grid.Row="1"
				              Height="8"
				              Background="Transparent"
				              ResizeDirection="Rows"
				              ResizeBehavior="PreviousAndNext" />

				<Border Grid.Row="2"
				        Background="{StaticResource Bg3}"
				        CornerRadius="8"
				        Padding="8">
					<Grid RowDefinitions="Auto,*"
					      RowSpacing="6">
						<Grid ColumnDefinitions="*,Auto">
							<StackPanel Orientation="Horizontal"
							            Spacing="8"
							            VerticalAlignment="Center">
								<TextBlock Text="Staged"
								           FontWeight="Bold" />
								<TextBlock Text="{Binding Staged.Count}"
								           Foreground="{StaticResource TextMuted}" />
							</StackPanel>
							<Button Grid.Column="1"
							        Command="{Binding UnstageAllCommand}"
							        ToolTip.Tip="Unstage everything"
							        Background="{StaticResource Bg4}"
							        CornerRadius="6">
								<StackPanel Orientation="Horizontal"
								            Spacing="6">
									<LucideIcon Kind="Minus"
									            Size="14"
									            StrokeWidth="2.5" />
									<TextBlock Text="Unstage All" />
								</StackPanel>
							</Button>
						</Grid>
						<ListBox Grid.Row="1"
						         x:Name="StagedList"
						         ItemsSource="{Binding Staged}"
						         ItemTemplate="{StaticResource FileRow}"
						         SelectionMode="Multiple"
						         Background="Transparent"
						         DoubleTapped="OnStagedDoubleTapped"
						         KeyDown="OnStagedKeyDown">
							<ListBox.ContextMenu>
								<ContextMenu>
									<MenuItem Click="OnUnstageClick"
									          InputGesture="Enter">
										<MenuItem.Header>
											<StackPanel Orientation="Horizontal"
											            Spacing="8">
												<LucideIcon Kind="Minus"
												            StrokeWidth="2.5"
												            Size="16" />
												<TextBlock Text="Unstage" />
											</StackPanel>
										</MenuItem.Header>
									</MenuItem>
								</ContextMenu>
							</ListBox.ContextMenu>
						</ListBox>
					</Grid>
				</Border>
			</Grid>

			<GridSplitter Grid.Column="1"
			              Width="8"
			              Background="Transparent"
			              ResizeDirection="Columns"
			              ResizeBehavior="PreviousAndNext" />

			<!-- Message -->
			<Border Grid.Column="2"
			        Background="{StaticResource Bg3}"
			        CornerRadius="8"
			        Padding="8"
			        MinWidth="260">
				<Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto"
				      RowSpacing="6">
					<StackPanel Orientation="Horizontal"
					            Spacing="8">
						<LucideIcon Kind="GitBranch"
						            Size="16"
						            StrokeWidth="2.5" />
						<TextBlock Text="{Binding BranchText}"
						           FontWeight="Bold" />
					</StackPanel>
					<TextBox Grid.Row="1"
					         Text="{Binding Message}"
					         PlaceholderText="Commit message"
					         MaxLines="1"
					         BorderThickness="0"
					         CornerRadius="8"
					         Background="{StaticResource Bg1}"
					         VerticalContentAlignment="Center"/>
					<TextBox Grid.Row="2"
					         Text="{Binding Description}"
					         PlaceholderText="Description"
					         AcceptsReturn="True"
					         TextWrapping="Wrap"
					         BorderThickness="0"
					         CornerRadius="8"
					         Background="{StaticResource Bg1}"
					         VerticalContentAlignment="Top"/>
					<TextBlock Grid.Row="3"
					           Text="{Binding Error}"
					           Foreground="{StaticResource Red}"
					           TextWrapping="Wrap"
					           MaxLines="6"
					           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
					<TextBlock Grid.Row="4"
					           Margin="0, 0, 0, 8"
					           Text="{Binding Status}"
					           Foreground="{StaticResource TextMuted}"
					           IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
					<Button Grid.Row="5"
					        Margin="0, -8, 0, 0"
					        Command="{Binding CommitCommand}"
					        HorizontalAlignment="Stretch"
					        HorizontalContentAlignment="Center"
					        Background="{StaticResource Red}"
					        Foreground="Black"
					        CornerRadius="6">
						<StackPanel Orientation="Horizontal"
						            Spacing="8">
							<LucideIcon Kind="GitCommitHorizontal"
							            Size="16"
							            StrokeWidth="3" />
							<TextBlock Text="Commit"
							           FontWeight="Bold" />
						</StackPanel>
					</Button>
					<Button Grid.Row="6"
					        Command="{Binding CommitAndPushCommand}"
					        HorizontalAlignment="Stretch"
					        HorizontalContentAlignment="Center"
					        Background="{StaticResource Bg4}"
					        CornerRadius="6">
						<StackPanel Orientation="Horizontal"
						            Spacing="8">
							<LucideIcon Kind="ArrowUp"
							            Size="16"
							            StrokeWidth="2.5" />
							<TextBlock Text="Commit and Push"
							           FontWeight="Bold" />
						</StackPanel>
					</Button>
				</Grid>
			</Border>
		</Grid>
	</Border>
</UserControl>
