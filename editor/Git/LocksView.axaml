<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:git="using:editor.Git"
             xmlns:elements="using:editor.Components.Elements"
             mc:Ignorable="d"
             x:Class="editor.Git.LocksView"
             x:DataType="git:LocksViewModel"
             d:DesignWidth="320"
             d:DesignHeight="600">
	<Border Background="{StaticResource Bg2}"
	        Padding="6">
		<Grid RowDefinitions="Auto,*"
		      RowSpacing="4">
			<Border Padding="6"
			        CornerRadius="8"
			        Background="{StaticResource Bg3}">
				<Grid RowDefinitions="Auto,Auto"
				      RowSpacing="4">
					<!-- First line: what is locked -->
					<StackPanel Grid.Row="0"
					            Orientation="Horizontal"
					            Spacing="4"
					            VerticalAlignment="Center">
						<LucideIcon Kind="Lock"
						            Size="16"
						            StrokeWidth="2.5" />
						<TextBlock Text="{Binding Summary}"
						           VerticalAlignment="Center" Classes="compact-text" />
					</StackPanel>

					<!-- Second line: refresh and unlock all on the left, artwork on the right -->
					<Grid Grid.Row="1"
					      ColumnDefinitions="Auto,*,Auto">
						<StackPanel Grid.Column="0"
						            Orientation="Horizontal"
						            Spacing="4">
							<Button Command="{Binding RefreshCommand}"
							        ToolTip.Tip="Refresh locks"
							        CornerRadius="6"
							        Background="{StaticResource Bg4}" Classes="compact-control">
								<LucideIcon Kind="RefreshCw"
								            Size="16"
								            StrokeWidth="2.5" />
							</Button>
							<Button Command="{Binding UnlockAllCommand}"
							        ToolTip.Tip="Unlock all your locks"
							        CornerRadius="6"
							        Background="{StaticResource Bg4}" Classes="compact-control">
								<LucideIcon Kind="LockOpen"
								            Size="16"
								            StrokeWidth="2.5" />
							</Button>
						</StackPanel>
						<Button Grid.Column="2"
						        Command="{Binding LockArtworkCommand}"
						        ToolTip.Tip="Choose which lockable files in artwork:// to lock"
						        CornerRadius="6"
						        Background="{StaticResource Bg4}" Classes="compact-control">
							<StackPanel Orientation="Horizontal"
							            Spacing="4">
								<LucideIcon Kind="Lock"
								            Size="16"
								            StrokeWidth="2.5" />
								<TextBlock Text="Artwork" Classes="compact-text" />
							</StackPanel>
						</Button>
					</Grid>
				</Grid>
			</Border>

			<Grid Grid.Row="1">
				<TextBlock Text="{Binding EmptyText}"
				           Foreground="{StaticResource TextMuted}"
				           HorizontalAlignment="Center"
				           VerticalAlignment="Center"
				           TextWrapping="Wrap"
				           IsVisible="{Binding !HasRows}" Classes="compact-text" />
				<ScrollViewer IsVisible="{Binding HasRows}">
					<ItemsControl ItemsSource="{Binding Rows}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="git:LockRow">
								<Border Background="{StaticResource Bg2}"
								        CornerRadius="6"
								        Margin="0,0,0,6">
									<Grid ColumnDefinitions="Auto,*,Auto"
									      ColumnSpacing="4">
										<Border Grid.Column="0"
										        Width="28"
										        Height="28"
										        CornerRadius="14"
										        ClipToBounds="True"
										        VerticalAlignment="Center"
										        Background="{Binding InitialsBrush}"
										        ToolTip.Tip="{Binding OwnerDetails}">
											<Panel>
												<TextBlock Text="{Binding Initials}"
												           FontSize="11"
												           FontWeight="Bold"
												           Foreground="{StaticResource Bg1}"
												           HorizontalAlignment="Center"
												           VerticalAlignment="Center"
												           IsVisible="{Binding !HasAvatar}" />
												<Image Source="{Binding Avatar}"
												       Stretch="UniformToFill"
												       IsVisible="{Binding HasAvatar}" />
											</Panel>
										</Border>

										<StackPanel Grid.Column="1"
										            Spacing="3"
										            VerticalAlignment="Center">
											<Grid ColumnDefinitions="Auto,Auto,*"
											      ColumnSpacing="4">
												<elements:GitChip Grid.Column="0"
												                  Status="{Binding Status}"
												                  VerticalAlignment="Center" />
												<Border Grid.Column="1"
												        VerticalAlignment="Center"
												        Background="{Binding TypeBrush}"
												        CornerRadius="4"
												        Padding="6,2">
													<TextBlock Text="{Binding TypeLabel}"
													           FontSize="10"
													           FontWeight="Bold"
													           Foreground="{StaticResource Bg1}" />
												</Border>
												<TextBlock Grid.Column="2"
												           Text="{Binding Name}"
												           FontWeight="SemiBold"
												           TextTrimming="CharacterEllipsis"
												           VerticalAlignment="Center" Classes="compact-text" />
											</Grid>
											<TextBlock Text="{Binding RelPath}"
											           FontSize="11"
											           Foreground="{StaticResource TextMuted}"
											           TextTrimming="CharacterEllipsis" />
										</StackPanel>

										<Button Grid.Column="2"
										        Command="{Binding UnlockCommand}"
										        IsVisible="{Binding IsMine}"
										        VerticalAlignment="Center"
										        ToolTip.Tip="Unlock"
										        CornerRadius="6"
										        Background="{StaticResource Bg4}" Classes="compact-control">
											<LucideIcon Kind="LockOpen"
											            Size="16"
											            StrokeWidth="2.5" />
										</Button>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</Grid>
	</Border>
</UserControl>
