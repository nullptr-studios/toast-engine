<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lucide="using:Lucide.Avalonia"
        xmlns:local="clr-namespace:editor.Components.Modals"
        x:Class="editor.Components.Modals.UnsavedChangesModal"
        x:DataType="local:UnsavedChangesViewModel"
        SizeToContent="Height"
        Width="480"
        MinWidth="360"
        CanResize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterOwner"
        KeyboardNavigation.TabNavigation="Cycle"
        ShowInTaskbar="False"
        Background="{StaticResource Bg3}"
        Title="{Binding Title}">

	<Window.Styles>
		<Style Selector="Button.primary">
			<Setter Property="Background"
			        Value="{StaticResource Red}" />
			<Setter Property="Foreground"
			        Value="White" />
			<Setter Property="MinWidth"
			        Value="80" />
		</Style>
	</Window.Styles>

	<StackPanel Margin="24"
	            Spacing="16">
		<StackPanel Orientation="Horizontal"
		            Spacing="12">
			<lucide:LucideIcon Size="32"
			                   StrokeWidth="2.5"
			                   Kind="Save"
			                   Foreground="{StaticResource Blue}" />
			<TextBlock Text="{Binding Title}"
			           FontSize="16"
			           FontWeight="SemiBold"
			           VerticalAlignment="Center" />
		</StackPanel>

		<TextBlock Text="{Binding Message}"
		           TextWrapping="Wrap"
		           Foreground="{StaticResource Text}" />

		<!-- Every unsaved file -->
		<Border Background="{StaticResource Bg1}"
		        CornerRadius="8"
		        Padding="8">
			<StackPanel Spacing="4">
				<Grid ColumnDefinitions="*,Auto"
				      ColumnSpacing="16"
				      Margin="8,0">
					<TextBlock Grid.Column="0"
					           Text="File"
					           FontWeight="SemiBold"
					           Foreground="{StaticResource TextMuted}" />
					<TextBlock Grid.Column="1"
					           Text="Type"
					           FontWeight="SemiBold"
					           Foreground="{StaticResource TextMuted}" />
				</Grid>
				<ScrollViewer MaxHeight="240"
				              VerticalScrollBarVisibility="Auto"
				              HorizontalScrollBarVisibility="Disabled">
					<ItemsControl ItemsSource="{Binding Rows}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Spacing="2" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:UnsavedChangesRow">
								<Border Background="{StaticResource Bg2}"
								        CornerRadius="6"
								        Padding="8,6">
									<Grid ColumnDefinitions="*,Auto"
									      ColumnSpacing="16">
										<TextBlock Grid.Column="0"
										           Text="{Binding Name}"
										           TextTrimming="CharacterEllipsis"
										           ToolTip.Tip="{Binding Name}" />
										<TextBlock Grid.Column="1"
										           Text="{Binding Kind}"
										           Foreground="{StaticResource TextMuted}" />
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</StackPanel>
		</Border>

		<Grid ColumnDefinitions="Auto,*,Auto,Auto"
		      ColumnSpacing="8"
		      Margin="0,8,0,0">
			<Button Grid.Column="0"
			        TabIndex="0"
			        IsCancel="True"
			        MinWidth="80"
			        Click="OnCancel"
			        HorizontalContentAlignment="Center">
				<TextBlock Text="Cancel" />
			</Button>
			<Button Grid.Column="2"
			        TabIndex="1"
			        Click="OnDiscardAll"
			        HorizontalContentAlignment="Center">
				<StackPanel Orientation="Horizontal">
					<LucideIcon Size="16"
					            StrokeWidth="2.5"
					            Margin="0,0,4,0"
					            Kind="Shredder" />
					<TextBlock Text="Discard All" />
				</StackPanel>
			</Button>
			<Button x:Name="SaveAllButton"
			        Grid.Column="3"
			        TabIndex="2"
			        IsDefault="True"
			        Classes="primary"
			        Click="OnSaveAll"
			        HorizontalContentAlignment="Center">
				<StackPanel Orientation="Horizontal">
					<LucideIcon Size="16"
					            StrokeWidth="2.5"
					            Margin="0,0,4,0"
					            Kind="Save" />
					<TextBlock Text="Save All" />
				</StackPanel>
			</Button>
		</Grid>
	</StackPanel>
</Window>
