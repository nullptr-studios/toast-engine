<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:editor.Components.Modals"
        xmlns:conv="using:editor.Components.Converters"
        xmlns:assets="clr-namespace:editor.Assets"
        x:Class="editor.Components.Modals.PickerWindow"
        Width="500"
        Height="600"
        CanResize="False"
        CanMaximize="False"
        CanMinimize="False"
        WindowStartupLocation="CenterOwner"
        KeyboardNavigation.TabNavigation="Cycle"
        Background="{StaticResource Bg2}"
        Padding="8">

	<Window.Styles>
		<Style Selector="TextBlock.highlighted">
			<Setter Property="FontWeight"
			        Value="Bold" />
			<Setter Property="Foreground"
			        Value="{StaticResource Red}" />
		</Style>
	</Window.Styles>

	<Window.Resources>
		<conv:ResourceBrushConverter x:Key="BrushFromKey" />
	</Window.Resources>

	<DockPanel VerticalSpacing="8">
		<!-- Search -->
		<Grid DockPanel.Dock="Top"
		      ColumnDefinitions="*,Auto"
		      ColumnSpacing="8">
			<TextBox x:Name="SearchBox"
			         TabIndex="0"
			         TextChanged="OnSearchChanged"
			         KeyDown="OnSearchKeyDown"
			         BorderThickness="0"
			         Background="{StaticResource Bg1}"
			         CornerRadius="6"
			         VerticalContentAlignment="Center"
			         PlaceholderText="Search...">
				<TextBox.InnerLeftContent>
					<LucideIcon Kind="Search"
					            Foreground="{StaticResource TextMuted}"
					            Size="16"
					            Margin="8,0,0,0"
					            StrokeWidth="3" />
				</TextBox.InnerLeftContent>
			</TextBox>
			<Button x:Name="ViewToggleButton"
			        Grid.Column="1"
			        IsVisible="False"
			        TabIndex="5"
			        CornerRadius="6"
			        Click="OnViewToggle">
				<LucideIcon x:Name="ViewToggleIcon"
				            Kind="ListTree"
				            Size="16"
				            StrokeWidth="3" />
			</Button>
		</Grid>

		<!-- Button bar -->
		<Grid DockPanel.Dock="Bottom">
			<Button x:Name="ExtraButton"
			        TabIndex="2"
			        HorizontalAlignment="Left"
			        IsVisible="False"
			        CornerRadius="6"
			        Click="OnExtraButton">
				<StackPanel Orientation="Horizontal"
				            Spacing="4">
					<LucideIcon x:Name="ExtraIcon"
					            Kind="Plus"
					            Size="16"
					            StrokeWidth="3.5" />
					<TextBlock x:Name="ExtraLabel"
					           Text="" />
				</StackPanel>
			</Button>
			<StackPanel HorizontalAlignment="Right"
			            FlowDirection="RightToLeft"
			            Orientation="Horizontal"
			            Spacing="8">
				<Button x:Name="AcceptButton"
				        TabIndex="4"
				        IsDefault="True"
				        Click="OnAccept"
				        CornerRadius="6"
				        Background="{StaticResource Red}"
				        Foreground="{StaticResource Text}"
				        FontWeight="Bold">
					<StackPanel Orientation="Horizontal"
					            Spacing="4"
					            FlowDirection="LeftToRight">
						<LucideIcon x:Name="AcceptIcon"
						            Kind="Check"
						            Size="16"
						            StrokeWidth="3.5" />
						<TextBlock x:Name="AcceptLabel"
						           Text="Select" />
					</StackPanel>
				</Button>
				<Button TabIndex="3"
				        IsCancel="True"
				        Click="OnCancel"
				        CornerRadius="6">
					<StackPanel Orientation="Horizontal"
					            Spacing="4"
					            FlowDirection="LeftToRight">
						<LucideIcon Kind="X"
						            Size="16"
						            StrokeWidth="3.5" />
						<TextBlock Text="Cancel" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>

		<!-- Content -->
		<Border Background="{StaticResource Bg1}"
		        CornerRadius="8"
		        Padding="8">
			<Grid>
			<ListBox x:Name="ItemsList"
			         x:CompileBindings="False"
			         TabIndex="1"
			         Focusable="True"
			         Background="Transparent"
			         Padding="0"
			         SelectionMode="Single"
			         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			         SelectionChanged="OnSelectionChanged"
			         KeyDown="OnListKeyDown"
			         PointerMoved="OnListPointerMoved"
			         PointerExited="OnListPointerExited">
				<ListBox.Styles>
					<Style Selector="ListBoxItem">
						<Setter Property="Padding"
						        Value="4,3" />
						<Setter Property="CornerRadius"
						        Value="8" />
						<Setter Property="MinHeight"
						        Value="0" />
					</Style>
					<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Background"
						        Value="{StaticResource Bg5}" />
					</Style>
					<Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Background"
						        Value="{StaticResource Bg4}" />
					</Style>
					<Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Background"
						        Value="{StaticResource Bg4}" />
					</Style>
				</ListBox.Styles>
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<VirtualizingStackPanel />
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>
				<ListBox.ItemTemplate>
					<DataTemplate DataType="local:PickerRow">
						<StackPanel Orientation="Horizontal"
						            Spacing="6"
						            Margin="{Binding Indent}">
							<!-- found by its class in code, see OnListPointerPressed -->
							<Panel Classes="chevron"
							       Width="16"
							       Height="16"
							       Background="Transparent"
							       VerticalAlignment="Center">
								<LucideIcon Kind="ChevronDown"
								            Size="14"
								            StrokeWidth="3"
								            IsHitTestVisible="False">
									<LucideIcon.IsVisible>
										<MultiBinding Converter="{x:Static BoolConverters.And}">
											<Binding Path="HasChildren" />
											<Binding Path="IsExpanded" />
										</MultiBinding>
									</LucideIcon.IsVisible>
								</LucideIcon>
								<LucideIcon Kind="ChevronRight"
								            Size="14"
								            StrokeWidth="3"
								            IsHitTestVisible="False">
									<LucideIcon.IsVisible>
										<MultiBinding Converter="{x:Static BoolConverters.And}">
											<Binding Path="HasChildren" />
											<Binding Path="!IsExpanded" />
										</MultiBinding>
									</LucideIcon.IsVisible>
								</LucideIcon>
							</Panel>
							<Panel Width="16"
							       Height="16"
							       IsVisible="{Binding IsFolder}"
							       VerticalAlignment="Center">
								<LucideIcon Kind="FolderOpen"
								            Size="16"
								            StrokeWidth="2.5"
								            IsVisible="{Binding IsExpanded}" />
								<LucideIcon Kind="Folder"
								            Size="16"
								            StrokeWidth="2.5"
								            IsVisible="{Binding !IsExpanded}" />
							</Panel>
							<ContentControl Content="{Binding Node}"
							                VerticalAlignment="Center">
								<ContentControl.DataTemplates>

									<!-- NodeDisplayItem -->
									<DataTemplate DataType="local:NodeDisplayItem">
										<StackPanel Orientation="Horizontal"
										            Spacing="8"
										            VerticalAlignment="Center">
											<Border Width="16"
											        Height="16"
											        Background="{Binding Color, Converter={StaticResource BrushFromKey}}">
												<Border.OpacityMask>
													<ImageBrush Source="{Binding Icon}" />
												</Border.OpacityMask>
											</Border>
											<ItemsControl ItemsSource="{Binding Segments}"
											              Opacity="{Binding Opacity}"
											              FontStyle="{Binding FontStyle}"
											              Foreground="{Binding TextColor}">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate>
														<StackPanel Orientation="Horizontal" />
													</ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<TextBlock Text="{Binding Text}"
														           Classes.highlighted="{Binding IsHighlighted}" />
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>
									</DataTemplate>

									<!-- HierarchyDisplayItem -->
									<DataTemplate DataType="local:HierarchyDisplayItem">
										<StackPanel Orientation="Horizontal"
										            Spacing="8"
										            VerticalAlignment="Center">
											<Border Width="16"
											        Height="16"
											        Opacity="{Binding Opacity}"
											        Background="{Binding Color, Converter={StaticResource BrushFromKey}}">
												<Border.OpacityMask>
													<ImageBrush Source="{Binding Icon}" />
												</Border.OpacityMask>
											</Border>
											<ItemsControl ItemsSource="{Binding Segments}"
											              Opacity="{Binding Opacity}">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate>
														<StackPanel Orientation="Horizontal" />
													</ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<TextBlock Text="{Binding Text}"
														           Classes.highlighted="{Binding IsHighlighted}" />
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>
									</DataTemplate>

									<!-- AssetPickerItem -->
									<DataTemplate DataType="local:AssetPickerItem">
										<StackPanel Orientation="Horizontal"
										            VerticalAlignment="Center"
										            Spacing="8">
											<Border Background="{Binding TypeColor}"
											        CornerRadius="4"
											        Padding="6,2"
											        VerticalAlignment="Center">
												<TextBlock Text="{Binding TypeLabel}"
												           FontSize="10"
												           FontWeight="Bold"
												           Foreground="{StaticResource Bg1}" />
											</Border>
											<StackPanel>
												<ItemsControl ItemsSource="{Binding Segments}"
												              VerticalAlignment="Center">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<StackPanel Orientation="Horizontal" />
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>
													<ItemsControl.ItemTemplate>
														<DataTemplate>
															<TextBlock Text="{Binding Text}"
															           Classes.highlighted="{Binding IsHighlighted}" />
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
												<TextBlock Text="{Binding Path}"
												           IsVisible="{Binding ShowPath}"
												           Foreground="{StaticResource TextMuted}"
												           FontSize="11"
												           Margin="0,2,0,0"
												           TextTrimming="CharacterEllipsis" />
											</StackPanel>
										</StackPanel>
									</DataTemplate>

									<!-- AssetFolderNode -->
									<DataTemplate DataType="local:AssetFolderNode">
										<TextBlock Text="{Binding Name}"
										           VerticalAlignment="Center" />
									</DataTemplate>
									<DataTemplate DataType="local:AssetTreeNode">
										<TextBlock Text="{Binding Name}"
										           VerticalAlignment="Center" />
									</DataTemplate>
								</ContentControl.DataTemplates>
							</ContentControl>
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		<!-- Hover preview -->
		<Popup x:Name="ThumbnailPopup"
		       Placement="Right"
		       IsLightDismissEnabled="False"
		       IsHitTestVisible="False">
			<Border Width="170"
			        Height="170"
			        CornerRadius="8"
			        ClipToBounds="True"
			        Background="{x:Static assets:CheckerBrush.Instance}">
				<Image x:Name="ThumbnailImage"
				       Stretch="UniformToFill" />
			</Border>
		</Popup>
			</Grid>
		</Border>
	</DockPanel>
</Window>
