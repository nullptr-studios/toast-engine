<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:editor.Editors"
             xmlns:elements="using:editor.Components.Elements"
             xmlns:assets="using:editor.Assets"
             xmlns:lucide="using:Lucide.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1400"
             d:DesignHeight="350"
             x:Class="editor.Editors.PaletteView"
             x:DataType="vm:PaletteViewModel"
             Background="{StaticResource Bg2}"
             Padding="8">

	<UserControl.KeyBindings>
		<KeyBinding Gesture="Ctrl+S"
		            Command="{Binding SaveCommand}" />
	</UserControl.KeyBindings>

	<UserControl.Styles>
		<Style Selector="TextBlock.lbl">
			<Setter Property="Foreground"
			        Value="{StaticResource TextMuted}" />
			<Setter Property="VerticalAlignment"
			        Value="Center" />
			<Setter Property="TextTrimming"
			        Value="CharacterEllipsis" />
		</Style>
		<Style Selector="TextBlock.section">
			<Setter Property="FontWeight"
			        Value="SemiBold" />
			<Setter Property="VerticalAlignment"
			        Value="Center" />
		</Style>
		<Style Selector="Button.icon-btn">
			<Setter Property="BorderThickness"
			        Value="0" />
			<Setter Property="Padding"
			        Value="5" />
			<Setter Property="CornerRadius"
			        Value="6" />
			<Setter Property="Cursor"
			        Value="Hand" />
			<Setter Property="Background"
			        Value="Transparent" />
			<Setter Property="VerticalAlignment"
			        Value="Center" />
		</Style>
		<Style Selector="Button.swatch"
		       x:DataType="vm:PaletteSwatchVM">
			<Setter Property="Padding"
			        Value="0" />
			<Setter Property="Margin"
			        Value="1" />
			<Setter Property="HorizontalAlignment"
			        Value="Stretch" />
			<Setter Property="VerticalAlignment"
			        Value="Stretch" />
			<Setter Property="CornerRadius"
			        Value="3" />
			<Setter Property="Cursor"
			        Value="Hand" />
			<Setter Property="BorderThickness"
			        Value="2" />
			<Setter Property="BorderBrush"
			        Value="Transparent" />
			<Setter Property="Background"
			        Value="{Binding Brush}" />
		</Style>
		<!-- empty -->
		<Style Selector="Button.swatch.unused">
			<Setter Property="Background"
			        Value="{StaticResource Bg2}" />
			<Setter Property="BorderThickness"
			        Value="0" />
		</Style>
		<Style Selector="Button.swatch.selected">
			<Setter Property="BorderThickness"
			        Value="2" />
			<Setter Property="BorderBrush"
			        Value="{StaticResource Text}" />
		</Style>
		<Style Selector="TextBlock.slot-number">
			<Setter Property="FontWeight"
			        Value="Bold" />
			<Setter Property="FontSize"
			        Value="11" />
			<Setter Property="HorizontalAlignment"
			        Value="Right" />
			<Setter Property="VerticalAlignment"
			        Value="Center" />
			<Setter Property="Margin"
			        Value="0,0,5,0" />
			<Setter Property="IsHitTestVisible"
			        Value="False" />
			<Setter Property="Foreground"
			        Value="{StaticResource Text}" />
		</Style>
		<Style Selector="TextBlock.slot-number.light">
			<Setter Property="Foreground"
			        Value="{StaticResource Bg1}" />
		</Style>
		<Style Selector="Border.card">
			<Setter Property="Background"
			        Value="{StaticResource Bg3}" />
			<Setter Property="CornerRadius"
			        Value="8" />
			<Setter Property="Padding"
			        Value="8" />
		</Style>
	</UserControl.Styles>

	<Design.DataContext>
		<vm:PaletteViewModel />
	</Design.DataContext>

	<Panel>

		<Grid ColumnDefinitions="0.6*,6,0.2*,6,0.2*"
		      IsVisible="{Binding HasContent}">

			<!-- The 255 swatches -->
			<Border Grid.Column="0"
			        Classes="card">
				<DockPanel VerticalSpacing="8">

					<DockPanel DockPanel.Dock="Top">
						<Button DockPanel.Dock="Right"
						        Classes="icon-btn"
						        Command="{Binding SaveCommand}"
						        Background="{StaticResource Red}"
						        ToolTip.Tip="Save (Ctrl+S)">
							<lucide:LucideIcon Kind="Save"
							                   Size="16"
							                   StrokeWidth="2.5" />
						</Button>
						<TextBlock Text="{Binding DisplayTitle}"
						           Classes="section" />
					</DockPanel>

					<ItemsControl ItemsSource="{Binding Swatches}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid Rows="16"
								             Columns="16" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:PaletteSwatchVM">
								<Panel>
									<Border Margin="1"
									        CornerRadius="3"
									        IsHitTestVisible="False"
									        Background="{x:Static assets:CheckerBrush.Instance}"
									        IsVisible="{Binding ShowChecker}" />
									<Button Classes="swatch"
									        Classes.selected="{Binding IsSelected}"
									        Classes.unused="{Binding !IsUsed}"
									        Command="{Binding SelectCommand}">
										<ToolTip.Tip>
											<StackPanel Spacing="4">
												<TextBlock Text="{Binding Title}"
												           FontWeight="SemiBold" />
												<StackPanel Spacing="4"
												            IsVisible="{Binding IsUsed}">
													<StackPanel Orientation="Horizontal"
													            Spacing="6">
														<Ellipse Width="10"
														         Height="10"
														         VerticalAlignment="Center"
														         Fill="{Binding AlbedoDot}" />
														<TextBlock Text="{Binding AlbedoText}" />
													</StackPanel>
													<StackPanel Orientation="Horizontal"
													            Spacing="6">
														<Ellipse Width="10"
														         Height="10"
														         VerticalAlignment="Center"
														         Fill="{Binding RmsDot}" />
														<TextBlock Text="{Binding RmsText}" />
													</StackPanel>
													<TextBlock Text="{Binding EmissiveText}" />
													<TextBlock Text="{Binding AlphaText}" />
												</StackPanel>
											</StackPanel>
										</ToolTip.Tip>
									</Button>
									<!-- plus icon -->
									<Path Data="M0,0.5 L1,0.5 M0.5,0 L0.5,1"
									      Stretch="Fill"
									      Width="8"
									      Height="8"
									      HorizontalAlignment="Center"
									      VerticalAlignment="Center"
									      Stroke="{StaticResource Bg3}"
									      StrokeThickness="2"
									      IsHitTestVisible="False"
									      IsVisible="{Binding !IsUsed}" />
									<TextBlock Classes="slot-number"
									           Classes.light="{Binding LightBackground}"
									           Text="{Binding SlotText}"
									           IsVisible="{Binding HasSlotText}" />
								</Panel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

				</DockPanel>
			</Border>

			<GridSplitter Grid.Column="1"
			              Background="Transparent"
			              ResizeDirection="Columns" />

			<!-- How the selected entry looks -->
			<Border Grid.Column="2"
			        Classes="card">
				<ScrollViewer>
					<StackPanel Spacing="8">

						<DockPanel>
							<Button DockPanel.Dock="Right"
							        Classes="icon-btn"
							        Command="{Binding ClearEntryCommand}"
							        IsEnabled="{Binding EntryInUse}"
							        ToolTip.Tip="Remove this entry from the palette">
								<lucide:LucideIcon Kind="Trash2"
								                   Size="16"
								                   StrokeWidth="2.5" />
							</Button>
							<TextBlock Text="{Binding SelectedLabel}"
							           Classes="section" />
						</DockPanel>

						<Border Background="{StaticResource Orange}"
						        Padding="4"
						        Margin="0, 0, 0, 4"
						        CornerRadius="8"
						        IsVisible="{Binding !EntryInUse}">
							<StackPanel Orientation="Horizontal"
							            Spacing="4"
							            HorizontalAlignment="Center">
								<LucideIcon Kind="SquareDashedMousePointer"
								            Foreground="{StaticResource Bg1}"
								            Size="18"
								            StrokeWidth="2.5"/>
								<TextBlock Text="This ID is empty"
								           FontWeight="Bold"
								           Foreground="{StaticResource Bg1}"
								           TextWrapping="Wrap"/>
							</StackPanel>
						</Border>

						<Grid ColumnDefinitions="Auto,*"
						      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
						      RowSpacing="6"
						      ColumnSpacing="8"
						      Margin="0, -4, 0, 0">
							<TextBlock Grid.Row="0" Grid.Column="0" Classes="lbl"
							           Text="Albedo" />
							<elements:Color3Box Grid.Row="0"
							                    Grid.Column="1"
							                    R="{Binding AlbedoR, Mode=TwoWay}"
							                    G="{Binding AlbedoG, Mode=TwoWay}"
							                    B="{Binding AlbedoB, Mode=TwoWay}" />

							<TextBlock Grid.Row="1"
							           Grid.Column="0"
							           Classes="lbl"
							           Text="Roughness" />
							<elements:DragFloatBox Grid.Row="1"
							                       Grid.Column="1"
							                       Value="{Binding Roughness, Mode=TwoWay}"
							                       Minimum="0"
							                       Maximum="1" />

							<TextBlock Grid.Row="2"
							           Grid.Column="0"
							           Classes="lbl"
							           Text="Metallic" />
							<elements:DragFloatBox Grid.Row="2"
							                       Grid.Column="1"
							                       Value="{Binding Metallic, Mode=TwoWay}"
							                       Minimum="0"
							                       Maximum="1" />

							<TextBlock Grid.Row="3"
							           Grid.Column="0"
							           Classes="lbl"
							           Text="Reflectivity" />
							<elements:DragFloatBox Grid.Row="3"
							                       Grid.Column="1"
							                       Value="{Binding Reflectivity, Mode=TwoWay}"
							                       Minimum="0"
							                       Maximum="1" />

							<TextBlock Grid.Row="4"
							           Grid.Column="0"
							           Classes="lbl"
							           Text="Emissive" />
							<elements:DragFloatBox Grid.Row="4"
							                       Grid.Column="1"
							                       Value="{Binding Emissive, Mode=TwoWay}"
							                       Minimum="0"
							                       Maximum="1" />
							
							<TextBlock Grid.Row="5"
							           Grid.Column="0"
							           Classes="lbl"
							           Text="Max emissive" />
							<elements:DragFloatBox Grid.Row="5"
							                       Grid.Column="1"
							                       Value="{Binding MaxEmissive, Mode=TwoWay}"
							                       Minimum="0" />
							
							<TextBlock Grid.Row="6"
							           Grid.Column="0"
							           Classes="lbl"
							           Text="Transparent" />
							<elements:BoolBox Grid.Row="6"
							                  Grid.Column="1"
							                  Value="{Binding Transparent, Mode=TwoWay}" />

							<TextBlock Grid.Row="7"
							           Grid.Column="0"
							           Classes="lbl"
							           Text="Alpha" />
							<elements:DragFloatBox Grid.Row="7"
							                       Grid.Column="1"
							                       Value="{Binding Alpha, Mode=TwoWay}"
							                       Minimum="0"
							                       Maximum="1" />
						</Grid>

<Grid ColumnDefinitions="Auto,*"
						      RowSpacing="6"
						      ColumnSpacing="8">
							
						</Grid>

					</StackPanel>
				</ScrollViewer>
			</Border>

			<GridSplitter Grid.Column="3"
			              Background="Transparent"
			              ResizeDirection="Columns" />
			<Border Grid.Column="4"
			        Classes="card">
				<ScrollViewer>
					<StackPanel Spacing="8">

						<TextBlock Text="Physics"
						           Classes="section" />

						<Grid ColumnDefinitions="Auto,*"
						      RowDefinitions="Auto,Auto"
						      RowSpacing="6"
						      ColumnSpacing="8">
							<TextBlock Classes="lbl"
							           Text="Slot" />
							<elements:EnumBox Grid.Column="1"
							                  Value="{Binding SelectedSlotLabel, Mode=TwoWay}"
							                  Options="{Binding SlotLabels}"
							                  ToolTip.Tip="Which material slot this voxel uses" />

							<TextBlock Grid.Row="1"
							           Classes="lbl"
							           Text="Burns into" />
							<elements:DragIntBox Grid.Row="1"
							                     Grid.Column="1"
							                     Value="{Binding TransformsTo, Mode=TwoWay}"
							                     Minimum="0"
							                     Maximum="255" />
						</Grid>

						<ContentControl Content="{Binding EditableSlot}">
							<ContentControl.ContentTemplate>
								<DataTemplate x:DataType="vm:PaletteSlotVM">
									<Grid ColumnDefinitions="Auto,*"
									      RowDefinitions="Auto,Auto,Auto"
									      RowSpacing="6"
									      ColumnSpacing="8">
										<TextBlock Classes="lbl"
										           Text="Name" />
										<elements:StringBox Grid.Column="1"
										                    Value="{Binding Name, Mode=TwoWay}"
										                    Wrap="False" />

										<TextBlock Grid.Row="1"
										           Classes="lbl"
										           Text="Physics" />
										<elements:AssetBox Grid.Row="1"
										                   Grid.Column="1"
										                   Value="{Binding PhysicsUid, Mode=TwoWay}"
										                   AssetType="physics_material" />

										<TextBlock Grid.Row="2"
										           Classes="lbl"
										           Text="Destruction" />
										<elements:AssetBox Grid.Row="2"
										                   Grid.Column="1"
										                   Value="{Binding DestructionUid, Mode=TwoWay}"
										                   AssetType="destruction_material" />
									</Grid>
								</DataTemplate>
							</ContentControl.ContentTemplate>
						</ContentControl>

					</StackPanel>
				</ScrollViewer>
			</Border>
		</Grid>

		<!-- Nothing open -->
		<TextBlock Text="Open a .tpal from the Asset Browser"
		           Classes="lbl"
		           HorizontalAlignment="Center"
		           VerticalAlignment="Center"
		           IsVisible="{Binding !HasContent}" />
	</Panel>
</UserControl>
